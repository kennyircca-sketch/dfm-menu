setInterval(()=>{
  if(staffLoggedIn&&!firebaseReady){
    if(document.getElementById('kitchen-panel').classList.contains('active')) renderKitchen();
    if(document.getElementById('waiter-panel').classList.contains('active'))  renderWaiter();
  }
},20000);

// ════════════════════════════════════════
// TABLE MANAGER
// ════════════════════════════════════════
let tmFilter = 'all';
let tablesList = JSON.parse(localStorage.getItem('dfm_tables')||'null') || [
  {id:'t1',name:'Table 1',seats:4,waiter:'Amina',section:'Main Hall',occupied:false},
  {id:'t2',name:'Table 2',seats:6,waiter:'Juma',section:'Main Hall',occupied:false},
  {id:'t3',name:'Table 3',seats:2,waiter:'Amina',section:'Terrace',occupied:false},
  {id:'t4',name:'Table 4',seats:8,waiter:'Hassan',section:'VIP Room',occupied:false},
  {id:'t5',name:'Table 5',seats:4,waiter:'Fatuma',section:'Garden',occupied:false},
];
const tmSave = () => localStorage.setItem('dfm_tables', JSON.stringify(tablesList));

function tmSetFilter(f, btn) {
  tmFilter = f;
  document.querySelectorAll('#tm-filter-row .filter-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  tmRender();
}

function tmAddTable() {
  const name = document.getElementById('tm-name').value.trim();
  const waiter = document.getElementById('tm-waiter').value.trim();
  if (!name) { alert('Please enter a table name.'); return; }
  tablesList.push({
    id: 't' + Date.now(),
    name,
    seats: parseInt(document.getElementById('tm-seats').value),
    waiter: waiter || 'Unassigned',
    section: document.getElementById('tm-section').value,
    occupied: false
  });
  tmSave();
  document.getElementById('tm-name').value = '';
  document.getElementById('tm-waiter').value = '';
  document.getElementById('tm-add-form').style.display = 'none';
  tmRender();
}

function tmToggle(id) {
  const t = tablesList.find(x => x.id === id);
  if (t) { t.occupied = !t.occupied; tmSave(); tmRender(); }
}

function tmDelete(id) {
  if (!confirm('Remove this table?')) return;
  tablesList = tablesList.filter(x => x.id !== id);
  tmSave(); tmRender();
}

function tmRender() {
  const filtered = tmFilter === 'all' ? tablesList : tablesList.filter(t => t.section === tmFilter);
  const occ = tablesList.filter(t => t.occupied).length;
  const free = tablesList.length - occ;

  document.getElementById('tm-stats').innerHTML = `
    <div class="stat-card"><div class="stat-num">${tablesList.length}</div><div class="stat-label">Total</div></div>
    <div class="stat-card"><div class="stat-num" style="color:#5cba84">${free}</div><div class="stat-label">Free</div></div>
    <div class="stat-card"><div class="stat-num" style="color:#e07450">${occ}</div><div class="stat-label">Occupied</div></div>`;

  const g = document.getElementById('tm-grid');
  if (!filtered.length) {
    g.innerHTML = '<div style="grid-column:1/-1;text-align:center;padding:2rem;color:var(--muted);font-size:13px">No tables in this section.<br>Tap <strong>+ Add Table</strong> to add one.</div>';
    return;
  }
  g.innerHTML = filtered.map(t => `
    <div style="background:var(--card);border:.5px solid ${t.occupied?'#3d7a5c':'var(--border)'};border-radius:12px;padding:.9rem 1rem;border-left:4px solid ${t.occupied?'#5cba84':'var(--border)'}">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:6px">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;font-weight:600;color:${t.occupied?'#5cba84':'var(--gold)'}">${t.name}</div>
        <span style="font-size:10px;padding:2px 8px;border-radius:10px;font-weight:500;background:${t.occupied?'#0a2215':'var(--ocean-mid)'};color:${t.occupied?'#5cba84':'var(--muted)'};border:.5px solid ${t.occupied?'#1d5c3b':'var(--border)'}">${t.occupied?'Occupied':'Free'}</span>
      </div>
      <div style="font-size:11px;color:var(--muted);margin-bottom:2px">🪑 ${t.seats} seats · ${t.section}</div>
      <div style="font-size:11px;color:var(--muted);margin-bottom:10px">🙋 ${t.waiter}</div>
      <div style="display:flex;gap:6px">
        <button onclick="tmToggle('${t.id}')" style="flex:1;padding:7px 6px;border-radius:7px;border:.5px solid var(--border);background:var(--ocean-mid);color:var(--text);font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">${t.occupied?'Mark Free':'Mark Busy'}</button>
        <button onclick="tmDelete('${t.id}')" style="padding:7px 10px;border-radius:7px;border:.5px solid #5c1a1a;background:none;color:#c46a6a;font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">✕</button>
      </div>
    </div>`).join('');
}


// ════════════════════════════════════════
// NOTIFICATION SOUND
// ════════════════════════════════════════
function playNotification(){
  try{
    const ctx = new (window.AudioContext||window.webkitAudioContext)();
    // Play 3 pleasant beeps
    [0, 0.18, 0.36].forEach(delay=>{
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.connect(gain);
      gain.connect(ctx.destination);
      osc.frequency.value = 880;
      osc.type = 'sine';
      gain.gain.setValueAtTime(0, ctx.currentTime+delay);
      gain.gain.linearRampToValueAtTime(0.4, ctx.currentTime+delay+0.02);
      gain.gain.linearRampToValueAtTime(0, ctx.currentTime+delay+0.15);
      osc.start(ctx.currentTime+delay);
      osc.stop(ctx.currentTime+delay+0.15);
    });
  } catch(e){ console.log('Sound error:',e); }
}

// ════════════════════════════════════════
// MANAGER PIN & SHELL
// ════════════════════════════════════════
let mgrPinEntry='';
function openManagerLogin(){
  mgrPinEntry='';updateMgrDots();
  document.getElementById('mgr-pin-error').textContent='\u00a0';
  hideAllScreens();
  document.getElementById('manager-login-screen').classList.add('active');
}
function mgrPinPress(d){if(mgrPinEntry.length>=6)return;mgrPinEntry+=d;updateMgrDots();if(mgrPinEntry.length===6)setTimeout(checkMgrPin,150);}
function mgrPinBack(){mgrPinEntry=mgrPinEntry.slice(0,-1);updateMgrDots();}
function updateMgrDots(){for(let i=0;i<6;i++)document.getElementById('mpd'+i).classList.toggle('filled',i<mgrPinEntry.length);}
async function checkMgrPin(){
  // ── BACKEND PATH — PIN hash lives on the server, real lockout, real session ──
  if(backendAuthReady){
    try{
      const result = await callFn('verifyPin', {pin:mgrPinEntry, role:'manager'});
      await firebase.auth().signInWithCustomToken(result.data.token);
      mgrLoggedIn=true;
      hideAllScreens();
      const sh=document.getElementById('manager-shell');
      sh.style.cssText='display:flex;flex-direction:column;min-height:100vh';
      renderMgrOverview();
      setInterval(()=>{ if(mgrLoggedIn && document.getElementById('mgr-overview').classList.contains('active')) renderMgrOverview(); },30000);
    } catch(e){
      mgrPinEntry='';updateMgrDots();
      document.getElementById('mgr-pin-error').textContent=friendlyFnError(e);
      setTimeout(()=>document.getElementById('mgr-pin-error').textContent='\u00a0',3000);
    }
    return;
  }

  // ── LOCAL-MODE FALLBACK (backend not deployed yet) — same as before ──
  const lock = checkLoginLock('gg_mgr_lock');
  if(lock.locked){
    document.getElementById('mgr-pin-error').textContent=`🔒 Too many tries. Wait ${lock.secsLeft}s`;
    mgrPinEntry='';updateMgrDots();
    return;
  }
  const entryHash = await sha256(mgrPinEntry);
  if(entryHash===MANAGER_PIN_HASH){
    clearLoginLock('gg_mgr_lock');
    mgrLoggedIn=true;
    hideAllScreens();
    const sh=document.getElementById('manager-shell');
    sh.style.cssText='display:flex;flex-direction:column;min-height:100vh';
    renderMgrOverview();
    setInterval(()=>{ if(mgrLoggedIn && document.getElementById('mgr-overview').classList.contains('active')) renderMgrOverview(); },30000);
  } else {
    recordLoginFail('gg_mgr_lock');
    document.getElementById('mgr-pin-error').textContent='❌ Wrong PIN — try again';
    mgrPinEntry='';updateMgrDots();
    setTimeout(()=>document.getElementById('mgr-pin-error').textContent='\u00a0',2000);
  }
}
function cancelManagerLogin(){
  hideAllScreens();
  showCustomerScreen('menu-screen');
}
function managerLogout(){
  mgrLoggedIn=false;
  hideAllScreens();
  showCustomerScreen('menu-screen');
}
function showMgrPanel(id,btn){
  document.querySelectorAll('#manager-shell .staff-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.mgr-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');
  if(btn) btn.classList.add('active');
}

// ── helper: filter orders by time range ──
function ordersInRange(range){
  const all=getOrders();
  const now=Date.now();
  if(range==='today'){
    const s=new Date(); s.setHours(0,0,0,0);
    return all.filter(o=>o.ts>=s.getTime());
  }
  if(range==='7')  return all.filter(o=>o.ts>=now-7*86400000);
  if(range==='30') return all.filter(o=>o.ts>=now-30*86400000);
  return all;
}

// ── OVERVIEW ──
function renderMgrOverview(){
  const now=new Date();
  document.getElementById('mgr-datetime').textContent=now.toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric'})+' · '+now.toLocaleTimeString('en-GB',{hour:'2-digit',minute:'2-digit'});
  const todayOrders=ordersInRange('today');
  const allOrders=getOrders();
  const rev=todayOrders.reduce((s,o)=>s+o.total,0);
  const tips=todayOrders.reduce((s,o)=>s+o.tip,0);
  const avgVal=todayOrders.length?Math.round(rev/todayOrders.length):0;
  const pending=todayOrders.filter(o=>o.status==='new'||o.status==='cooking').length;

  document.getElementById('mgr-kpis').innerHTML=`
    <div class="mgr-kpi"><div class="mgr-kpi-num">${todayOrders.length}</div><div class="mgr-kpi-label">Today's Orders</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${fmt(rev)}</div><div class="mgr-kpi-label">Today's Revenue</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${fmt(tips)}</div><div class="mgr-kpi-label">Today's Tips</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${fmt(avgVal)}</div><div class="mgr-kpi-label">Avg Order Value</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num" style="color:${pending>0?'#e07450':'#6dd98a'}">${pending}</div><div class="mgr-kpi-label">Pending in Kitchen</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${allOrders.length}</div><div class="mgr-kpi-label">All-Time Orders</div></div>`;

  // Kitchen status
  const nw=todayOrders.filter(o=>o.status==='new').length;
  const ck=todayOrders.filter(o=>o.status==='cooking').length;
  const rd=todayOrders.filter(o=>o.status==='ready').length;
  const dn=todayOrders.filter(o=>o.status==='done').length;
  document.getElementById('mgr-kitchen-status').innerHTML=`
    <div style="display:flex;flex-direction:column;gap:8px">
      ${[['🔴 New',nw,'#e07450'],['🟡 Cooking',ck,'#c8a84b'],['🟢 Ready',rd,'#6dd98a'],['✓ Done',dn,'#3a8aaa']].map(([lbl,cnt,col])=>`
      <div style="display:flex;align-items:center;gap:8px;font-size:12px">
        <div style="width:70px;color:#3a7a50">${lbl}</div>
        <div class="mgr-bar-wrap"><div class="mgr-bar" style="background:${col};width:${Math.round(cnt/Math.max(todayOrders.length,1)*100)}%"></div></div>
        <div style="width:20px;text-align:right;color:${col};font-weight:600">${cnt}</div>
      </div>`).join('')}
    </div>`;

  // Table status
  const occ=tablesList.filter(t=>t.occupied).length;
  const free=tablesList.length-occ;
  document.getElementById('mgr-table-status').innerHTML=`
    <div style="display:flex;gap:10px;margin-bottom:10px">
      <div style="flex:1;text-align:center;background:#0d2a18;border-radius:10px;padding:.6rem">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.6rem;color:#6dd98a">${free}</div>
        <div style="font-size:10px;color:#3a7a50;letter-spacing:1px">FREE</div>
      </div>
      <div style="flex:1;text-align:center;background:#1a0a0a;border-radius:10px;padding:.6rem">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.6rem;color:#e07450">${occ}</div>
        <div style="font-size:10px;color:#7a3a3a;letter-spacing:1px">OCCUPIED</div>
      </div>
    </div>
    <div style="font-size:11px;color:#3a7a50;text-align:center">${tablesList.length} tables total · ${Math.round(occ/Math.max(tablesList.length,1)*100)}% occupancy</div>`;

  // Recent orders
  const recent=todayOrders.slice(0,5);
  const scMap={new:'#e07450',cooking:'#c8a84b',ready:'#6dd98a',done:'#3a8aaa'};
  document.getElementById('mgr-recent-orders').innerHTML=recent.length===0
    ?'<div style="color:#3a7a50;font-size:12px;text-align:center;padding:1rem">No orders today yet.</div>'
    :recent.map(o=>`
      <div style="display:flex;justify-content:space-between;align-items:center;padding:8px 0;border-bottom:.5px solid #1e4030;font-size:12px">
        <div>
          <span style="font-family:Georgia,'Times New Roman',serif;color:var(--text)">${o.id}</span>
          <span style="color:#3a7a50;margin-left:8px">Table ${escapeHtml(o.table)} · ${o.time||'--:--'}</span>
        </div>
        <div style="display:flex;align-items:center;gap:8px">
          <span style="color:#6dd98a;font-family:Georgia,'Times New Roman',serif">${fmt(o.total)}</span>
          <span style="padding:2px 8px;border-radius:10px;font-size:10px;background:#0d2a18;color:${scMap[o.status]||'#888'};border:.5px solid ${scMap[o.status]||'#888'}">${o.status}</span>
        </div>
      </div>`).join('');
}

// ── SALES REPORT ──
function renderMgrSales(){
  const di=document.getElementById('mgr-sales-date');
  if(!di.value){const t=new Date();di.value=t.toISOString().split('T')[0];}
  const [y,m,d]=di.value.split('-').map(Number);
  const s=new Date(y,m-1,d,0,0,0,0).getTime(), e=new Date(y,m-1,d,23,59,59,999).getTime();
  const orders=getOrders().filter(o=>o.ts>=s&&o.ts<=e);
  const label=new Date(y,m-1,d).toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  document.getElementById('mgr-sales-date-label').textContent=label;
  const rev=orders.reduce((s,o)=>s+o.total,0);
  const tips=orders.reduce((s,o)=>s+o.tip,0);
  const avg=orders.length?Math.round(rev/orders.length):0;
  const done=orders.filter(o=>o.status==='done').length;
  document.getElementById('mgr-sales-kpis').innerHTML=`
    <div class="mgr-kpi"><div class="mgr-kpi-num">${orders.length}</div><div class="mgr-kpi-label">Orders</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${fmt(rev)}</div><div class="mgr-kpi-label">Revenue</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${fmt(tips)}</div><div class="mgr-kpi-label">Tips</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${fmt(avg)}</div><div class="mgr-kpi-label">Avg Value</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${done}</div><div class="mgr-kpi-label">Completed</div></div>`;
  // Hourly
  const hb=Array.from({length:24},(_,h)=>({h,count:0,rev:0}));
  orders.forEach(o=>{const h=new Date(o.ts).getHours();hb[h].count++;hb[h].rev+=o.total;});
  const ah=hb.filter(b=>b.count>0);
  const maxR=Math.max(...hb.map(b=>b.rev),1);
  document.getElementById('mgr-hourly').innerHTML=ah.length===0
    ?'<div style="color:#3a7a50;font-size:12px;text-align:center;padding:.5rem">No data.</div>'
    :ah.map(b=>`<div style="display:flex;align-items:center;gap:8px;padding:5px 0;font-size:12px">
        <div style="width:42px;color:#3a7a50;text-align:right;flex-shrink:0">${b.h.toString().padStart(2,'0')}:00</div>
        <div class="mgr-bar-wrap"><div class="mgr-bar" style="width:${Math.round(b.rev/maxR*100)}%"></div></div>
        <div style="width:28px;text-align:right;color:var(--text);flex-shrink:0">${b.count}</div>
        <div style="width:90px;text-align:right;color:#3a7a50;font-size:11px;flex-shrink:0">${fmt(b.rev)}</div>
      </div>`).join('');
  // Day orders
  const scMap={new:'#e07450',cooking:'#c8a84b',ready:'#6dd98a',done:'#3a8aaa'};
  document.getElementById('mgr-day-orders').innerHTML=orders.length===0
    ?'<div style="color:#3a7a50;font-size:12px;text-align:center;padding:1rem">No orders.</div>'
    :[...orders].sort((a,b)=>b.ts-a.ts).map(o=>`
      <div style="display:flex;justify-content:space-between;align-items:flex-start;padding:9px 0;border-bottom:.5px solid #1e4030;gap:8px;font-size:12px">
        <div>
          <div style="font-family:Georgia,'Times New Roman',serif;color:var(--text)">${o.id}</div>
          <div style="color:#3a7a50;margin-top:2px">Table ${escapeHtml(o.table)} · ${escapeHtml(o.waiter)} · ${o.time||'--:--'}</div>
          <div style="color:#3a7a50;margin-top:2px">${(o.items||[]).map(it=>`${escapeHtml(it.name)} ×${it.qty}`).join(', ')}</div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div style="font-family:Georgia,'Times New Roman',serif;color:#6dd98a">${fmt(o.total)}</div>
          <div style="margin-top:4px;padding:2px 8px;border-radius:10px;font-size:10px;background:#0d2a18;color:${scMap[o.status]||'#888'};border:.5px solid ${scMap[o.status]||'#888'};display:inline-block">${o.status}</div>
        </div>
      </div>`).join('');
}
function exportMgrCSV(){
  const di=document.getElementById('mgr-sales-date');if(!di.value)return;
  const [y,m,d]=di.value.split('-').map(Number);
  const s=new Date(y,m-1,d,0,0,0,0).getTime(),e=new Date(y,m-1,d,23,59,59,999).getTime();
  const orders=getOrders().filter(o=>o.ts>=s&&o.ts<=e);
  const rows=[['Order ID','Table','Waiter','Time','Items','Subtotal','Tip','Total','Status']];
  orders.forEach(o=>rows.push([o.id,o.table,o.waiter,o.time||'',(o.items||[]).map(it=>`${it.name} x${it.qty}`).join(' | '),o.sub,o.tip,o.total,o.status]));
  const csv=rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\n');
  const a=document.createElement('a');a.href=URL.createObjectURL(new Blob([csv],{type:'text/csv'}));a.download=`${BRAND_CONFIG.shortCode}-Manager-${di.value}.csv`;a.click();
}

// ── TOP ITEMS ──
function renderMgrItems(){
  const range=document.getElementById('mgr-items-range').value;
  const orders=ordersInRange(range);
  const map={};
  orders.forEach(o=>(o.items||[]).forEach(it=>{
    if(!map[it.name])map[it.name]={name:it.name,emoji:it.emoji||'🍽️',qty:0,rev:0,orders:0};
    map[it.name].qty+=it.qty;map[it.name].rev+=it.price*it.qty;map[it.name].orders++;
  }));
  const items=Object.values(map).sort((a,b)=>b.qty-a.qty);
  const maxQ=items[0]?.qty||1;
  document.getElementById('mgr-items-grid').innerHTML=items.length===0
    ?'<div style="color:#3a7a50;font-size:13px;text-align:center;padding:2rem">No data for this period.</div>'
    :items.map((it,i)=>`
      <div class="mgr-item-card">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.4rem;color:#3a7a50;min-width:28px;text-align:center">${i+1}</div>
        <div style="font-size:22px">${it.emoji}</div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;color:var(--text);font-weight:500">${escapeHtml(it.name)}</div>
          <div class="mgr-bar-wrap" style="margin-top:5px"><div class="mgr-bar" style="width:${Math.round(it.qty/maxQ*100)}%"></div></div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:#6dd98a;font-weight:700">×${it.qty}</div>
          <div style="font-size:10px;color:#3a7a50">${fmt(it.rev)}</div>
        </div>
      </div>`).join('');
}

// ── STAFF MONITOR ──
function renderMgrStaff(){
  const orders=getOrders();
  const map={};
  orders.forEach(o=>{
    const w=o.waiter||'Unknown';
    if(!map[w])map[w]={name:w,orders:0,rev:0,tips:0,tables:new Set()};
    map[w].orders++;map[w].rev+=o.total;map[w].tips+=o.tip;map[w].tables.add(o.table);
  });
  const staff=Object.values(map).sort((a,b)=>b.rev-a.rev);
  const scMap={new:'#e07450',cooking:'#c8a84b',ready:'#6dd98a',done:'#3a8aaa'};
  document.getElementById('mgr-staff-grid').innerHTML=staff.length===0
    ?'<div style="color:#3a7a50;font-size:13px;text-align:center;padding:2rem">No order data yet.</div>'
    :staff.map((s,i)=>`
      <div class="mgr-item-card" style="flex-direction:column;align-items:stretch;gap:8px">
        <div style="display:flex;align-items:center;gap:10px">
          <div style="width:36px;height:36px;border-radius:50%;background:#0d2a18;border:.5px solid #1e4030;display:flex;align-items:center;justify-content:center;font-size:16px;flex-shrink:0">🙋</div>
          <div style="flex:1">
            <div style="font-size:14px;font-weight:600;color:var(--text)">${s.name}</div>
            <div style="font-size:10px;color:#3a7a50;letter-spacing:.5px">${s.tables.size} table${s.tables.size!==1?'s':''} served</div>
          </div>
          <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;color:#6dd98a">#${i+1}</div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:6px;text-align:center">
          <div style="background:#0d2a18;border-radius:8px;padding:6px">
            <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;color:#6dd98a">${s.orders}</div>
            <div style="font-size:9px;color:#3a7a50;letter-spacing:1px;text-transform:uppercase">Orders</div>
          </div>
          <div style="background:#0d2a18;border-radius:8px;padding:6px">
            <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:#6dd98a">${fmt(s.rev)}</div>
            <div style="font-size:9px;color:#3a7a50;letter-spacing:1px;text-transform:uppercase">Revenue</div>
          </div>
          <div style="background:#0d2a18;border-radius:8px;padding:6px">
            <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:#6dd98a">${fmt(s.tips)}</div>
            <div style="font-size:9px;color:#3a7a50;letter-spacing:1px;text-transform:uppercase">Tips</div>
          </div>
        </div>
      </div>`).join('');
}

// ── TABLES ──
function renderMgrTables(){
  const occ=tablesList.filter(t=>t.occupied).length;
  const free=tablesList.length-occ;
  document.getElementById('mgr-tables-stats').innerHTML=`
    <div class="mgr-kpi"><div class="mgr-kpi-num">${tablesList.length}</div><div class="mgr-kpi-label">Total Tables</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num" style="color:#6dd98a">${free}</div><div class="mgr-kpi-label">Free</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num" style="color:#e07450">${occ}</div><div class="mgr-kpi-label">Occupied</div></div>
    <div class="mgr-kpi"><div class="mgr-kpi-num">${Math.round(occ/Math.max(tablesList.length,1)*100)}%</div><div class="mgr-kpi-label">Occupancy</div></div>`;
  document.getElementById('mgr-tables-grid').innerHTML=tablesList.map(t=>`
    <div style="background:#0a1a10;border:.5px solid ${t.occupied?'#3d7a5c':'#1e4030'};border-radius:12px;padding:.9rem 1rem;border-left:4px solid ${t.occupied?'#6dd98a':'#1e4030'}">
      <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:5px">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;font-weight:600;color:${t.occupied?'#6dd98a':'#3a7a50'}">${t.name}</div>
        <span style="font-size:10px;padding:2px 7px;border-radius:10px;background:${t.occupied?'#0d2a18':'#0a1a10'};color:${t.occupied?'#6dd98a':'#3a7a50'};border:.5px solid ${t.occupied?'#3d7a5c':'#1e4030'}">${t.occupied?'Occupied':'Free'}</span>
      </div>
      <div style="font-size:11px;color:#3a7a50">🪑 ${t.seats} seats · ${t.section}</div>
      <div style="font-size:11px;color:#3a7a50;margin-top:2px">🙋 ${t.waiter}</div>
    </div>`).join('');
}

// ── ALL ORDERS ──
function renderMgrOrders(){
  const range=document.getElementById('mgr-orders-range').value;
  const filter=document.getElementById('mgr-orders-filter').value;
  let orders=ordersInRange(range);
  if(filter!=='all')orders=orders.filter(o=>o.status===filter);
  orders=[...orders].sort((a,b)=>b.ts-a.ts);
  const scMap={new:'#e07450',cooking:'#c8a84b',ready:'#6dd98a',done:'#3a8aaa'};
  document.getElementById('mgr-orders-list').innerHTML=orders.length===0
    ?'<div style="color:#3a7a50;font-size:13px;text-align:center;padding:2rem">No orders found.</div>'
    :orders.map(o=>`
      <div style="display:flex;justify-content:space-between;align-items:flex-start;padding:10px 0;border-bottom:.5px solid #1e4030;gap:8px;font-size:12px">
        <div>
          <div style="font-family:Georgia,'Times New Roman',serif;color:var(--text)">${o.id}</div>
          <div style="color:#3a7a50;margin-top:2px">Table ${escapeHtml(o.table)} · ${escapeHtml(o.waiter)} · ${new Date(o.ts).toLocaleDateString('en-GB')} ${o.time||''}</div>
          <div style="color:#3a7a50;margin-top:2px">${(o.items||[]).map(it=>`${escapeHtml(it.name)} ×${it.qty}`).join(', ')}</div>
          ${o.special?`<div style="color:#c8a84b;margin-top:2px;font-size:11px">📝 ${escapeHtml(o.special)}</div>`:''}
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div style="font-family:Georgia,'Times New Roman',serif;color:#6dd98a">${fmt(o.total)}</div>
          <div style="font-size:10px;color:#3a7a50;margin-top:2px">${fmt(o.tip)} tip</div>
          <div style="margin-top:4px;padding:2px 8px;border-radius:10px;font-size:10px;background:#0d2a18;color:${scMap[o.status]||'#888'};border:.5px solid ${scMap[o.status]||'#888'};display:inline-block">${o.status}</div>
        </div>
      </div>`).join('');
}

// ════════════════════════════════════════
// DAILY SALES REPORT (Staff panel)
// ════════════════════════════════════════
function renderReport(){
  const dateInput = document.getElementById('rpt-date');
  if(!dateInput.value){
    const today = new Date();
    dateInput.value = today.toISOString().split('T')[0];
  }
  const [y,m,d] = dateInput.value.split('-').map(Number);
  const dayStart = new Date(y,m-1,d,0,0,0,0).getTime();
  const dayEnd   = new Date(y,m-1,d,23,59,59,999).getTime();

  const allOrders = getOrders();
  const orders = allOrders.filter(o => o.ts >= dayStart && o.ts <= dayEnd);

  // Date label
  const label = new Date(y,m-1,d).toLocaleDateString('en-GB',{weekday:'long',day:'numeric',month:'long',year:'numeric'});
  document.getElementById('rpt-date-label').textContent = label;

  // KPIs
  const totalRev   = orders.reduce((s,o)=>s+o.total,0);
  const totalTips  = orders.reduce((s,o)=>s+o.tip,0);
  const avgOrder   = orders.length ? Math.round(totalRev/orders.length) : 0;
  const doneOrders = orders.filter(o=>o.status==='done').length;

  document.getElementById('rpt-kpis').innerHTML = `
    <div class="rpt-kpi"><div class="rpt-kpi-num">${orders.length}</div><div class="rpt-kpi-label">Total Orders</div></div>
    <div class="rpt-kpi"><div class="rpt-kpi-num">${fmt(totalRev)}</div><div class="rpt-kpi-label">Total Revenue</div></div>
    <div class="rpt-kpi"><div class="rpt-kpi-num">${fmt(totalTips)}</div><div class="rpt-kpi-label">Total Tips</div></div>
    <div class="rpt-kpi"><div class="rpt-kpi-num">${fmt(avgOrder)}</div><div class="rpt-kpi-label">Avg Order Value</div></div>
    <div class="rpt-kpi"><div class="rpt-kpi-num">${doneOrders}</div><div class="rpt-kpi-label">Completed</div></div>`;

  // Top items
  const itemMap = {};
  orders.forEach(o=>{
    (o.items||[]).forEach(it=>{
      if(!itemMap[it.name]) itemMap[it.name]={name:it.name,emoji:it.emoji||'🍽️',qty:0,rev:0};
      itemMap[it.name].qty += it.qty;
      itemMap[it.name].rev += it.price*it.qty;
    });
  });
  const topItems = Object.values(itemMap).sort((a,b)=>b.qty-a.qty).slice(0,8);
  const maxQty = topItems[0]?.qty||1;
  document.getElementById('rpt-top-items').innerHTML = topItems.length===0
    ? '<div style="color:var(--muted);font-size:12px;text-align:center;padding:1rem">No orders for this date.</div>'
    : topItems.map((it,i)=>`
      <div class="rpt-item-row">
        <div style="width:22px;font-size:11px;color:var(--muted);text-align:right">${i+1}</div>
        <div style="font-size:18px">${it.emoji}</div>
        <div style="flex:1;min-width:0">
          <div style="font-size:13px;color:var(--text);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escapeHtml(it.name)}</div>
          <div class="rpt-item-bar-wrap" style="margin-top:4px"><div class="rpt-item-bar" style="width:${Math.round(it.qty/maxQty*100)}%"></div></div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div style="font-size:13px;color:var(--gold);font-weight:600">×${it.qty}</div>
          <div style="font-size:10px;color:var(--muted)">${fmt(it.rev)}</div>
        </div>
      </div>`).join('');

  // Hourly breakdown
  const hourBuckets = Array.from({length:24},(_,h)=>({h,count:0,rev:0}));
  orders.forEach(o=>{
    const h = new Date(o.ts).getHours();
    hourBuckets[h].count++;
    hourBuckets[h].rev += o.total;
  });
  const activeHours = hourBuckets.filter(b=>b.count>0);
  const maxCount = Math.max(...hourBuckets.map(b=>b.count),1);
  document.getElementById('rpt-hourly').innerHTML = activeHours.length===0
    ? '<div style="color:var(--muted);font-size:12px;text-align:center;padding:.5rem">No orders for this date.</div>'
    : activeHours.map(b=>{
        const label=b.h.toString().padStart(2,'0')+':00';
        return `<div class="rpt-hour-row">
          <div style="width:42px;color:var(--muted);text-align:right;flex-shrink:0">${label}</div>
          <div class="rpt-hour-bar-wrap"><div class="rpt-hour-bar" style="width:${Math.round(b.count/maxCount*100)}%"></div></div>
          <div style="width:28px;text-align:right;color:var(--text);flex-shrink:0">${b.count}</div>
          <div style="width:90px;text-align:right;color:var(--muted);font-size:11px;flex-shrink:0">${fmt(b.rev)}</div>
        </div>`;
      }).join('');

  // Orders list
  const statusColor={new:'#e07450',cooking:var_gold(),ready:'#5cba84',done:'#3a8aaa',cancelled:'#888'};
  const statusBg   ={new:'#2a100a',cooking:'#1a1500',ready:'#0a2215',done:'#0a1a2a',cancelled:'#1a1a1a'};
  document.getElementById('rpt-orders-list').innerHTML = orders.length===0
    ? '<div style="color:var(--muted);font-size:12px;text-align:center;padding:1rem">No orders for this date.</div>'
    : [...orders].sort((a,b)=>b.ts-a.ts).map(o=>`
      <div class="rpt-ord-row">
        <div>
          <div style="font-family:Georgia,'Times New Roman',serif;font-size:.95rem;color:var(--text)">${o.id}</div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px">Table ${escapeHtml(o.table)} · ${escapeHtml(o.waiter)} · ${o.time||'--:--'}</div>
          <div style="font-size:11px;color:var(--muted);margin-top:2px">${(o.items||[]).map(it=>`${escapeHtml(it.name)} ×${it.qty}`).join(', ')}</div>
        </div>
        <div style="text-align:right;flex-shrink:0">
          <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:var(--gold)">${fmt(o.total)}</div>
          <div style="margin-top:4px"><span class="rpt-status-pill" style="color:${statusColor[o.status]||'#888'};background:${statusBg[o.status]||'#1a1a1a'};border:.5px solid ${statusColor[o.status]||'#888'}">${o.status||'new'}</span></div>
        </div>
      </div>`).join('');
}

function var_gold(){ return '#c8a84b'; }

function exportReportCSV(){
  const dateInput = document.getElementById('rpt-date');
  if(!dateInput.value) return;
  const [y,m,d] = dateInput.value.split('-').map(Number);
  const dayStart = new Date(y,m-1,d,0,0,0,0).getTime();
  const dayEnd   = new Date(y,m-1,d,23,59,59,999).getTime();
  const orders   = getOrders().filter(o=>o.ts>=dayStart&&o.ts<=dayEnd);

  const rows = [['Order ID','Table','Waiter','Time','Items','Subtotal','Tip','Total','Status']];
  orders.forEach(o=>{
    rows.push([
      o.id, o.table, o.waiter, o.time||'',
      (o.items||[]).map(it=>`${it.name} x${it.qty}`).join(' | '),
      o.sub, o.tip, o.total, o.status
    ]);
  });
  const csv = rows.map(r=>r.map(v=>'"'+String(v).replace(/"/g,'""')+'"').join(',')).join('\n');
  const blob = new Blob([csv],{type:'text/csv'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = `${BRAND_CONFIG.shortCode}-Report-${dateInput.value}.csv`;
  a.click();
}

// ════════════════════════════════════════
// INIT
// ════════════════════════════════════════
applyBranding();
updatePendingBadge();
renderMenu();
updateBar();
initFirebase();
flushPendingOrders();
</script>
</body>
</html>
