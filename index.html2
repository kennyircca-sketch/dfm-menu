};

let menuData=JSON.parse(localStorage.getItem('dfm_menu')||'null')||JSON.parse(JSON.stringify(defaultMenu));
const cart={};
let tipPct=15,kFilter='all',selectedQRTable=1,triggerCount=0,triggerTimer=null,pinEntry='';
const fmt=n=>'TSh '+Math.round(n).toLocaleString();
function saveMenu(){
  localStorage.setItem('dfm_menu',JSON.stringify(menuData)); // instant local paint + offline cache
  if(backendAuthReady && (staffLoggedIn||mgrLoggedIn)){
    // Goes through the server, which checks the real role claim before writing.
    callFn('updateMenu', {menuData}).catch(()=>{
      if(firebaseReady && db){ db.ref('menu').set(menuData).catch(()=>{}); }
    });
  } else if(firebaseReady && db){
    db.ref('menu').set(menuData).catch(()=>{});
  }
}
const tagMap={fresh:'<span class="tag tag-fresh">✦ Fresh</span>',spicy:'<span class="tag tag-spicy">🌶 Spicy</span>',sushi:'<span class="tag tag-sushi">🍣 Sushi</span>',grill:'<span class="tag tag-grill">🔥 Grill</span>'};
const tagHTML=tags=>(tags||[]).map(t=>tagMap[t]||'').join('');

// ════════════════════════════════════════
// RENDER MENU
// ════════════════════════════════════════
function renderMenu(){
  ['starters','mains','sushi','desserts','drinks'].forEach(cat=>{
    const sec=document.getElementById(cat);
    const hdr=sec.querySelector('.sec-hdr').outerHTML;
    sec.innerHTML=hdr;
    (menuData[cat]||[]).forEach((item,i)=>{
      const qty=cart[item.id]?.qty||0;
      const d=document.createElement('div');
      d.className='menu-card';d.style.animationDelay=(i*.05)+'s';
      const imgHTML=item.img
        ?`<img class="card-img" src="${escapeHtml(item.img)}" alt="${escapeHtml(item.name)}" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"><div class="card-img-placeholder" style="display:none">${item.emoji}</div>`
        :`<div class="card-img-placeholder">${item.emoji}</div>`;
      d.innerHTML=`${imgHTML}<div class="card-body">
        <div class="card-top"><div class="item-name">${escapeHtml(item.name)}</div><div class="item-price">${fmt(item.price)}</div></div>
        ${(item.tags||[]).length?`<div class="item-tags">${tagHTML(item.tags)}</div>`:''}
        <div class="item-desc">${item.desc}</div>
        <div class="qty-row">
          <button class="qty-btn" onclick="changeQty('${item.id}','${cat}',-1)">−</button>
          <div class="qty-num" id="qty-${item.id}">${qty||'+'}</div>
          <button class="qty-btn" onclick="changeQty('${item.id}','${cat}',1)">+</button>
        </div></div>`;
      sec.appendChild(d);
    });
  });
}
function changeQty(id,cat,delta){
  const item=Object.values(menuData).flat().find(i=>i.id===id);
  if(!cart[id]) cart[id]={item,qty:0};
  cart[id].qty=Math.max(0,cart[id].qty+delta);
  if(cart[id].qty===0) delete cart[id];
  const el=document.getElementById('qty-'+id);
  if(el) el.textContent=cart[id]?.qty||'+';
  updateBar();
}
function updateBar(){
  const t=Object.values(cart).reduce((s,v)=>s+v.qty,0);
  document.getElementById('bar-count').innerHTML=t===0?'No items selected':`<strong>${t}</strong> item${t>1?'s':''} selected`;
  document.getElementById('view-btn').disabled=t===0;
}

// ════════════════════════════════════════
// SCREENS
// ════════════════════════════════════════
function hideAllScreens(){
  ['menu-screen','order-screen','confirm-screen'].forEach(s=>document.getElementById(s).classList.remove('active'));
  document.getElementById('staff-login-screen').classList.remove('active');
  document.getElementById('manager-login-screen').classList.remove('active');
  document.getElementById('staff-shell').style.display='none';
  document.getElementById('manager-shell').style.display='none';
}
function showCustomerScreen(id){
  hideAllScreens();
  document.getElementById(id).classList.add('active');
  if(id==='order-screen') renderOrderLines();
}
function goToOrder(){showCustomerScreen('order-screen');}
function enterApp(){
  const cover = document.getElementById('cover-screen');
  if(!cover || cover.classList.contains('diving')) return;
  cover.classList.add('diving');
  setTimeout(()=>{ cover.style.display='none'; }, 900);
}
function showTab(cat,btn){
  document.querySelectorAll('.section').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.tab-btn').forEach(t=>t.classList.remove('active'));
  document.getElementById(cat).classList.add('active');btn.classList.add('active');
}

// ════════════════════════════════════════
// ORDER
// ════════════════════════════════════════
function renderOrderLines(){
  const items=Object.values(cart);
  document.getElementById('order-lines').innerHTML=items.length===0
    ?'<p style="color:var(--muted);font-size:13px;padding:1rem 0">Your order is empty.</p>'
    :items.map(({item,qty})=>`<div class="order-line"><div><div class="ol-name">${item.emoji} ${escapeHtml(item.name)}</div><div class="ol-qty">× ${qty}</div></div><div class="ol-price">${fmt(item.price*qty)}</div></div>`).join('');
  renderTotals();
}
function setTip(pct,btn){
  tipPct=pct;
  document.querySelectorAll('.tip-btn').forEach(b=>b.classList.remove('active'));
  btn.classList.add('active');renderTotals();
}
function renderTotals(){
  const sub=Object.values(cart).reduce((s,{item,qty})=>s+item.price*qty,0);
  const tip=Math.round(sub*tipPct/100);
  document.getElementById('totals-box').innerHTML=`
    <div class="t-row"><span>Subtotal</span><span>${fmt(sub)}</span></div>
    <div class="t-row"><span>Gratuity (${tipPct}%)</span><span>${fmt(tip)}</span></div>
    <div class="t-row t-grand"><span>Total</span><span>${fmt(sub+tip)}</span></div>`;
}
// ════════════════════════════════════════
// RATE LIMITING — stops fake order floods
// Max 3 orders per hour per device
// 60 second cooldown between orders
// ════════════════════════════════════════
const RATE_LIMIT = {
  maxOrders: 3,        // max orders allowed per hour
  cooldownSecs: 60,    // seconds to wait between orders
  windowMs: 60*60*1000 // 1 hour window
};

function getRateLimitData(){
  try{
    return JSON.parse(localStorage.getItem('gg_rate')||'{"orders":[],"blocked":false,"blockedUntil":0}');
  } catch(e){
    return {orders:[],blocked:false,blockedUntil:0};
  }
}

function saveRateLimitData(data){
  localStorage.setItem('gg_rate', JSON.stringify(data));
}

function checkRateLimit(){
  const now = Date.now();
  const data = getRateLimitData();

  // Check if device is blocked
  if(data.blocked && now < data.blockedUntil){
    const minsLeft = Math.ceil((data.blockedUntil - now) / 60000);
    return {
      allowed: false,
      reason: `Too many orders. Please wait ${minsLeft} minute${minsLeft>1?'s':''} before ordering again.\n\nMaagizo mengi sana. Tafadhali subiri dakika ${minsLeft}.`
    };
  }

  // Remove orders older than 1 hour
  data.orders = data.orders.filter(t => now - t < RATE_LIMIT.windowMs);

  // Check cooldown between orders
  if(data.orders.length > 0){
    const lastOrder = data.orders[data.orders.length - 1];
    const secsSinceLast = Math.floor((now - lastOrder) / 1000);
    if(secsSinceLast < RATE_LIMIT.cooldownSecs){
      const secsLeft = RATE_LIMIT.cooldownSecs - secsSinceLast;
      return {
        allowed: false,
        reason: `Please wait ${secsLeft} seconds before placing another order.\n\nSubiri sekunde ${secsLeft} kabla ya agizo lingine.`
      };
    }
  }

  // Check max orders per hour
  if(data.orders.length >= RATE_LIMIT.maxOrders){
    // Block this device for 1 hour
    data.blocked = true;
    data.blockedUntil = now + RATE_LIMIT.windowMs;
    saveRateLimitData(data);
    return {
      allowed: false,
      reason: `You have placed too many orders. Your device is temporarily blocked for 1 hour.\n\nUmeweka maagizo mengi sana. Kifaa chako kimezuiwa kwa saa 1.`
    };
  }

  return { allowed: true };
}

function recordOrder(){
  const data = getRateLimitData();
  data.orders.push(Date.now());
  data.blocked = false;
  saveRateLimitData(data);
}

// ── PIN brute-force lockout: 5 wrong tries = 2 min lock, per key (staff/manager) ──
function getLoginLockData(key){
  try{ return JSON.parse(localStorage.getItem(key)||'{"fails":0,"lockedUntil":0}'); }
  catch(e){ return {fails:0,lockedUntil:0}; }
}
function saveLoginLockData(key,data){ localStorage.setItem(key, JSON.stringify(data)); }
function checkLoginLock(key){
  const data = getLoginLockData(key);
  const now = Date.now();
  if(data.lockedUntil && now < data.lockedUntil){
    return { locked:true, secsLeft: Math.ceil((data.lockedUntil-now)/1000) };
  }
  return { locked:false };
}
function recordLoginFail(key){
  const data = getLoginLockData(key);
  data.fails = (data.fails||0)+1;
  if(data.fails>=5){
    data.lockedUntil = Date.now() + 2*60*1000; // 2 minute lock
    data.fails = 0;
  }
  saveLoginLockData(key,data);
}
function clearLoginLock(key){
  saveLoginLockData(key,{fails:0,lockedUntil:0});
}

function renderConfirm(order,pending){
  document.getElementById('conf-num').textContent=order.id||'—';
  document.getElementById('conf-detail').innerHTML=`
    ${pending?`<div class="c-row" style="background:rgba(200,168,75,.15);border-radius:8px;padding:10px;margin-bottom:10px;color:var(--gold)">⏳ No connection right now — this order is saved on this device and will be sent to the kitchen automatically once it's back online. If it's urgent, please tell a staff member directly.</div>`:''}
    <div class="c-row"><span>Meza / Table</span><span>${escapeHtml(order.table)}</span></div>
    <div class="c-row"><span>Waiter</span><span>${escapeHtml(order.waiter)}</span></div>
    <div class="c-row"><span>Time</span><span>${order.time}</span></div>
    <div class="c-row"><span>Items</span><span>${order.items.map(i=>`${escapeHtml(i.name)} ×${i.qty}`).join(', ')}</span></div>
    <div class="c-row"><span>Subtotal</span><span>${fmt(order.sub)}</span></div>
    <div class="c-row"><span>Gratuity</span><span>${fmt(order.tip)}</span></div>
    <div class="c-gold c-row"><span>Total${pending?' (estimated)':''}</span><span>${fmt(order.total)}</span></div>
    ${order.special?`<div class="c-row"><span>Notes</span><span>${escapeHtml(order.special)}</span></div>`:''}`;
}
// Builds a local price estimate from cart + cached menu prices — used only
// to show *something* on the confirm screen while an order sits in the
// offline queue waiting to reach the server for real validation.
function buildLocalEstimate(special){
  const sub=Object.values(cart).reduce((s,{item,qty})=>s+item.price*qty,0);
  const tip=Math.round(sub*tipPct/100);
  const now=new Date();
  const timeStr=now.getHours().toString().padStart(2,'0')+':'+now.getMinutes().toString().padStart(2,'0');
  return {
    id:'#'+BRAND_CONFIG.shortCode+'-'+Date.now().toString(36).toUpperCase()+'-'+Math.random().toString(36).slice(2,7).toUpperCase(),
    table:TABLE,waiter:WAITER,
    items:Object.values(cart).map(({item,qty})=>({name:item.name,emoji:item.emoji,qty,price:item.price})),
    sub,tip,total:sub+tip,special,time:timeStr,ts:Date.now(),status:'new'
  };
}
const SERVER_REJECTION_CODES=['permission-denied','resource-exhausted','invalid-argument'];
async function placeOrder(){
  const btn=document.getElementById('place-btn');

  // ── EMPTY CART CHECK ──
  if(Object.keys(cart).length===0){
    alert('Your cart is empty — add an item before placing your order.\n\nKikapu chako ni tupu — ongeza kitu kwanza.');
    return;
  }

  const special=document.getElementById('special-req').value.trim();
  btn.disabled=true;btn.textContent='Inatumwa jikoni...';

  // ── BACKEND PATH — server recalculates price/total and enforces rate limiting.
  // The browser's numbers are never trusted when this path is available. ──
  if(backendAuthReady){
    const itemsPayload = Object.values(cart).map(({item,qty})=>({id:item.id,qty}));
    const payload = {table:TABLE, waiter:WAITER, items:itemsPayload, special, tipPct};
    try{
      const result = await callFn('placeOrderSecure', payload);
      const order = result.data;
      renderConfirm(order,false);
      setTimeout(()=>showCustomerScreen('confirm-screen'),1000);
    } catch(e){
      if(SERVER_REJECTION_CODES.includes(e.code)){
        // The server received this and explicitly said no — not a connectivity issue, don't queue it.
        btn.disabled=false;btn.textContent='Tuma Agizo — Place Order';
        alert(friendlyFnError(e));
      } else {
        // Couldn't even reach the server — queue it and tell the customer honestly.
        queuePendingOrder({mode:'backend',payload,queuedAt:Date.now()});
        recordOrder();
        renderConfirm(buildLocalEstimate(special),true);
        setTimeout(()=>showCustomerScreen('confirm-screen'),1000);
      }
    }
    return;
  }

  // ── LOCAL-MODE FALLBACK (backend not deployed yet) ──
  const check = checkRateLimit();
  if(!check.allowed){
    btn.disabled=false;btn.textContent='Tuma Agizo — Place Order';
    alert(check.reason);
    return;
  }
  const order = buildLocalEstimate(special);
  const reachedCloud = await saveOrderToCloud(order);
  recordOrder(); // ← record this order in rate limiter
  renderConfirm(order, !reachedCloud);
  setTimeout(()=>showCustomerScreen('confirm-screen'),1000);
}
function resetOrder(){
  Object.keys(cart).forEach(k=>delete cart[k]);
  tipPct=15;
  document.getElementById('place-btn').disabled=false;
  document.getElementById('place-btn').textContent='Tuma Agizo — Place Order';
  document.getElementById('special-req').value='';
  renderMenu();updateBar();showCustomerScreen('menu-screen');
}

// ════════════════════════════════════════
// STAFF PIN
// ════════════════════════════════════════
function staffTriggerTap(){
  triggerCount++;
  if(triggerTimer) clearTimeout(triggerTimer);
  triggerTimer=setTimeout(()=>triggerCount=0,2500);
  if(triggerCount>=8){triggerCount=0;openManagerLogin();}
  else if(triggerCount>=5){triggerCount=0;openStaffLogin();}
}
function openStaffLogin(){
  pinEntry='';updatePinDots();
  document.getElementById('pin-error').textContent='\u00a0';
  hideAllScreens();
  document.getElementById('staff-login-screen').classList.add('active');
}
function pinPress(d){if(pinEntry.length>=6)return;pinEntry+=d;updatePinDots();if(pinEntry.length===6)setTimeout(checkPin,150);}
function pinBack(){pinEntry=pinEntry.slice(0,-1);updatePinDots();}
function updatePinDots(){for(let i=0;i<6;i++)document.getElementById('pd'+i).classList.toggle('filled',i<pinEntry.length);}
async function checkPin(){
  // ── BACKEND PATH — PIN hash lives on the server, real lockout, real session ──
  if(backendAuthReady){
    try{
      const result = await callFn('verifyPin', {pin:pinEntry, role:'staff'});
      await firebase.auth().signInWithCustomToken(result.data.token);
      staffLoggedIn=true;
      hideAllScreens();
      const sh=document.getElementById('staff-shell');
      sh.style.cssText='display:flex;flex-direction:column;min-height:100vh';
      renderKitchen();renderAdminList();buildQRPanel();
    } catch(e){
      pinEntry='';updatePinDots();
      document.getElementById('pin-error').textContent=friendlyFnError(e);
      setTimeout(()=>document.getElementById('pin-error').textContent='\u00a0',3000);
    }
    return;
  }

  // ── LOCAL-MODE FALLBACK (backend not deployed yet) — same as before ──
  const lock = checkLoginLock('gg_staff_lock');
  if(lock.locked){
    document.getElementById('pin-error').textContent=`🔒 Too many tries. Wait ${lock.secsLeft}s`;
    pinEntry='';updatePinDots();
    return;
  }
  const entryHash = await sha256(pinEntry);
  if(entryHash===STAFF_PIN_HASH){
    clearLoginLock('gg_staff_lock');
    staffLoggedIn=true;
    hideAllScreens();
    const sh=document.getElementById('staff-shell');
    sh.style.cssText='display:flex;flex-direction:column;min-height:100vh';
    renderKitchen();renderAdminList();buildQRPanel();
  } else {
    recordLoginFail('gg_staff_lock');
    document.getElementById('pin-error').textContent='❌ Wrong PIN — try again';
    pinEntry='';updatePinDots();
    setTimeout(()=>document.getElementById('pin-error').textContent='\u00a0',2000);
  }
}
function cancelStaffLogin(){
  hideAllScreens();
  showCustomerScreen('menu-screen');
}
function staffLogout(){
  staffLoggedIn=false;
  hideAllScreens();
  showCustomerScreen('menu-screen');
}
function showStaffPanel(id,btn){
  document.querySelectorAll('.staff-panel').forEach(p=>p.classList.remove('active'));
  document.querySelectorAll('.staff-tab').forEach(t=>t.classList.remove('active'));
  document.getElementById(id).classList.add('active');btn.classList.add('active');
  if(id==='kitchen-panel') renderKitchen();
  if(id==='waiter-panel')  renderWaiter();
  if(id==='admin-panel')   renderAdminList();
  if(id==='qr-panel')      buildQRPanel();
  if(id==='tables-panel')  tmRender();
}

// ════════════════════════════════════════
// KITCHEN
// ════════════════════════════════════════
function setKFilter(f,btn){kFilter=f;document.querySelectorAll('.filter-tab').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderKitchen();}
function elapsed(ts){const m=Math.floor((Date.now()-ts)/60000);return m<1?'Just now':m===1?'1 min ago':m+' mins ago';}
const pillMap={new:'<span class="status-pill pill-new">🔴 New Order</span>',cooking:'<span class="status-pill pill-cooking">🟡 Cooking</span>',ready:'<span class="status-pill pill-ready">🟢 Ready to Serve</span>',done:'<span class="status-pill pill-done">✓ Served</span>'};
function renderKitchen(){
  const all=getOrders();
  const show=kFilter==='all'?all.filter(o=>o.status!=='done'):all.filter(o=>o.status===kFilter);
  const nw=all.filter(o=>o.status==='new').length,ck=all.filter(o=>o.status==='cooking').length,rd=all.filter(o=>o.status==='ready').length,dn=all.filter(o=>o.status==='done').length;
  document.getElementById('kitchen-stats').innerHTML=`
    <div class="stat-card"><div class="stat-num" style="color:#e07450">${nw}</div><div class="stat-label">New</div></div>
    <div class="stat-card"><div class="stat-num">${ck}</div><div class="stat-label">Cooking</div></div>
    <div class="stat-card"><div class="stat-num" style="color:#5cba84">${rd}</div><div class="stat-label">Ready</div></div>
    <div class="stat-card"><div class="stat-num" style="color:#3a6a8a">${dn}</div><div class="stat-label">Done</div></div>`;
  if(!show.length){document.getElementById('kitchen-grid').innerHTML=`<div class="no-orders"><div class="no-orders-icon">🍳</div>No ${kFilter==='all'?'active':kFilter} orders right now.<br><span style="font-size:12px">New orders appear here instantly.</span></div>`;return;}
  document.getElementById('kitchen-grid').innerHTML=show.map(o=>`
    <div class="ticket status-${o.status}">
      <div class="ticket-head">
        <div><div class="ticket-table-num">Meza ${escapeHtml(o.table)}</div><div class="ticket-table-sub">Waiter: ${escapeHtml(o.waiter)}</div>${pillMap[o.status]||''}</div>
        <div class="ticket-meta"><div class="ticket-id">${o.id}</div><div class="ticket-time">${o.time}</div><div class="ticket-elapsed">${elapsed(o.ts)}</div></div>
      </div>
      <div class="ticket-items">${o.items.map(i=>`<div class="t-item-row"><div class="t-item-name">${i.emoji} ${escapeHtml(i.name)}</div><div style="display:flex;gap:4px;align-items:center"><span class="t-item-qty">×${i.qty}</span><span class="t-item-price">${fmt(i.price*i.qty)}</span></div></div>`).join('')}</div>
      ${o.special?`<div class="ticket-note">📝 ${escapeHtml(o.special)}</div>`:''}
      <div class="ticket-footer">
        <div class="ticket-total">${fmt(o.total)}</div>
        <div class="action-btns">
          ${o.status==='new'    ?`<button class="act-btn btn-start"  onclick="chStatus('${o.id}','cooking')">👨‍🍳 Start</button>`:''}
          ${o.status==='cooking'?`<button class="act-btn btn-ready"  onclick="chStatus('${o.id}','ready')">✅ Ready</button>`:''}
          ${o.status==='ready'  ?`<button class="act-btn btn-done"   onclick="chStatus('${o.id}','done')">🏁 Served</button>`:''}
          ${o.status!=='done'   ?`<button class="act-btn btn-cancel" onclick="chStatus('${o.id}','done')" title="Cancel">✕</button>`:''}
        </div>
      </div>
    </div>`).join('');
}
function renderWaiter(){
  const orders=getOrders().filter(o=>o.status==='ready'||o.status==='cooking');
  const g=document.getElementById('waiter-grid');
  if(!orders.length){g.innerHTML=`<div class="no-orders"><div class="no-orders-icon">✅</div>All caught up!<br><span style="font-size:12px">No orders waiting to be served.</span></div>`;return;}
  g.innerHTML=orders.map(o=>`
    <div class="ticket status-${o.status}">
      <div class="ticket-head">
        <div><div class="ticket-table-num">Meza ${escapeHtml(o.table)}</div><div class="ticket-table-sub">${escapeHtml(o.id)} · ${o.time}</div>${pillMap[o.status]||''}</div>
        <div class="ticket-meta"><div class="ticket-elapsed">${elapsed(o.ts)}</div></div>
      </div>
      <div class="ticket-items">${o.items.map(i=>`<div class="t-item-row"><div class="t-item-name">${i.emoji} ${escapeHtml(i.name)}</div><span class="t-item-qty">×${i.qty}</span></div>`).join('')}</div>
      ${o.special?`<div class="ticket-note">📝 ${escapeHtml(o.special)}</div>`:''}
      <div class="ticket-footer">
        <div class="ticket-total">${fmt(o.total)}</div>
        ${o.status==='ready'?`<button class="act-btn btn-done" onclick="chStatus('${o.id}','done')">🏁 Mark Served</button>`:'<span style="font-size:11px;color:var(--muted)">⏳ Still cooking…</span>'}
      </div>
    </div>`).join('');
}
async function chStatus(id,status){
  if(firebaseReady){ await cloudStatus(id,status); }
  else { const a=lGet(),o=a.find(x=>x.id===id);if(o){o.status=status;lSaveAll(a);}renderKitchen();renderWaiter(); }
}

// ════════════════════════════════════════
// ADMIN
// ════════════════════════════════════════
function addMenuItem(){
  const name=document.getElementById('f-name').value.trim();
  const cat=document.getElementById('f-cat').value;
  const price=parseInt(document.getElementById('f-price').value)||0;
  const emoji=document.getElementById('f-emoji').value||'🍽️';
  const desc=document.getElementById('f-desc').value.trim();
  const img=document.getElementById('f-img').value.trim();
  if(!name||!price){alert('Please enter a name and price.');return;}
  // Only allow real http(s) image links — blocks javascript:/data: URL tricks in the photo field.
  const safeImg = /^https?:\/\//i.test(img) ? img : '';
  const tags=[];
  if(document.getElementById('f-fresh').checked) tags.push('fresh');
  if(document.getElementById('f-spicy').checked) tags.push('spicy');
  if(document.getElementById('f-sushi').checked) tags.push('sushi');
  if(document.getElementById('f-grill').checked) tags.push('grill');
  if(!menuData[cat]) menuData[cat]=[];
  menuData[cat].push({id:'c'+Date.now(),name,desc,price,emoji,tags,img:safeImg});
  saveMenu();
  ['f-name','f-price','f-emoji','f-desc','f-img'].forEach(f=>document.getElementById(f).value='');
  ['f-fresh','f-spicy','f-sushi','f-grill'].forEach(f=>document.getElementById(f).checked=false);
  renderMenu();renderAdminList();
  alert('✅ "'+name+'" added to menu!');
}
function deleteItem(id){
  if(!confirm('Remove this item?')) return;
  Object.keys(menuData).forEach(cat=>{menuData[cat]=menuData[cat].filter(i=>i.id!==id);});
  saveMenu();renderMenu();renderAdminList();
}
function renderAdminList(){
  const all=Object.values(menuData).flat();
  document.getElementById('item-count').textContent=all.length;
  document.getElementById('admin-list-items').innerHTML=all.map(item=>`
    <div class="admin-item-card">
      <div class="ai-emoji">${item.emoji}</div>
      <div class="ai-info"><div class="ai-name">${escapeHtml(item.name)}</div><div class="ai-sub">${escapeHtml((item.desc||'').slice(0,55))}…</div></div>
      <div class="ai-price">${fmt(item.price)}</div>
      <button class="del-btn" onclick="deleteItem('${item.id}')">Remove</button>
    </div>`).join('');
}

// ════════════════════════════════════════
// QR CODES
// ════════════════════════════════════════
function buildQRPanel(){
  const g=document.getElementById('qr-table-grid');g.innerHTML='';
  for(let t=1;t<=NUM_TABLES;t++){
    const btn=document.createElement('button');
    btn.className='qr-tbl-btn'+(t===selectedQRTable?' active':'');
    btn.textContent='Table '+t;
    btn.onclick=(n=>()=>{
      document.querySelectorAll('.qr-tbl-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('qr-custom-table').value='';
      selectedQRTable=n;refreshQR();
    })(t);
    g.appendChild(btn);
  }
  const customInput=document.getElementById('qr-custom-table');
  customInput.oninput=()=>{
    // Same characters the backend accepts — what you see here is what will actually be allowed.
    const v=customInput.value.replace(/[^a-zA-Z0-9 \-]/g,'').slice(0,12);
    if(v!==customInput.value) customInput.value=v;
    if(v){
      document.querySelectorAll('.qr-tbl-btn').forEach(b=>b.classList.remove('active'));
      selectedQRTable=v;refreshQR();
    } else if(NUM_TABLES>0){
      selectedQRTable=1;
      document.querySelector('.qr-tbl-btn')?.classList.add('active');
      refreshQR();
    }
  };
  refreshQR();
}
function refreshQR(){
  const base=location.href.split('?')[0];
  const url=`${base}?table=${encodeURIComponent(selectedQRTable)}&waiter=${encodeURIComponent(VALID_WAITERS[0])}`;
  document.getElementById('qr-url-text').textContent='🔗 '+url;
  document.getElementById('qr-dl-label').textContent=selectedQRTable;
  const canvas=document.getElementById('qr-canvas'),ctx=canvas.getContext('2d');
  const img=new Image();img.crossOrigin='anonymous';
  img.onload=()=>{ctx.clearRect(0,0,220,220);ctx.drawImage(img,0,0,220,220);};
  img.onerror=()=>{ctx.fillStyle='#555';ctx.textAlign='center';ctx.font='11px sans-serif';ctx.fillText('QR needs internet',110,110);};
  img.src=`https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=${encodeURIComponent(url)}&bgcolor=ffffff&color=0b2f3a&qzone=2&format=png`;
}
function downloadQR(){
  const a=document.createElement('a');
  a.download=`${BRAND_CONFIG.shortCode}-Table-${selectedQRTable}-QR.png`;
  a.href=document.getElementById('qr-canvas').toDataURL('image/png');
  a.click();
}

