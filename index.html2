<!DOCTYPE html>
<html lang="sw">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<title>Dar Fish Market Restaurant</title>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-database-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-auth-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.23.0/firebase-functions-compat.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Caveat:wght@500;600;700&display=swap" rel="stylesheet">

<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --font-d:Georgia,"Times New Roman",serif;
  --font-b:system-ui,-apple-system,"Segoe UI",sans-serif;
  --gold:#c8a84b;--gold-dim:#8a6f2e;--gold-bg:#1a1500;
  --ocean:#0b2f3a;--ocean-mid:#123d4d;
  --surface:#0a0d0e;--card:#111a1e;--border:#1e3040;
  --text:#f0ede6;--muted:#6a8a98;
  --font-d:'Cormorant Garamond',Georgia,serif;
  --font-b:'DM Sans',sans-serif;
}
html{scroll-behavior:smooth}
body{background:var(--surface);color:var(--text);font-family:system-ui,-apple-system,sans-serif;min-height:100vh}
.screen{display:none!important}.screen.active{display:block!important}
.screen-flex{display:none!important}.screen-flex.active{display:flex!important}
header{background:var(--ocean);border-bottom:1px solid var(--border);padding:1rem 1.25rem;text-align:center}
header::after{content:'';display:block;height:1px;background:linear-gradient(to right,transparent,var(--gold),transparent);margin-top:.9rem;opacity:.5}
.brand{font-family:Georgia,'Times New Roman',serif;font-size:1.9rem;font-weight:700;letter-spacing:3px;color:var(--gold);text-transform:uppercase}
.brand-sub{font-size:10px;letter-spacing:3px;color:var(--muted);text-transform:uppercase;margin-top:1px}
.badge-row{margin-top:.8rem;display:flex;justify-content:center;gap:10px;flex-wrap:wrap}
.badge{background:var(--ocean-mid);border:1px solid var(--border);border-radius:20px;padding:4px 12px;font-size:11px;color:var(--muted);display:inline-flex;align-items:center;gap:5px}
.badge strong{color:var(--gold);font-weight:500}
.conn-dot{width:7px;height:7px;border-radius:50%;display:inline-block;margin-right:3px}
.conn-dot.online{background:#3d9a5c;animation:pulse 2s infinite}
.conn-dot.offline{background:#9a3d3d}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.3}}
.tabs-wrap{background:var(--ocean);border-bottom:1px solid var(--border);position:sticky;top:0;z-index:50}
.tabs{display:flex;overflow-x:auto;scrollbar-width:none}
.tabs::-webkit-scrollbar{display:none}
.tab-btn{flex:1;min-width:75px;padding:13px 6px;font-family:system-ui,-apple-system,sans-serif;font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--muted);background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;white-space:nowrap;transition:all .2s}
.tab-btn.active{color:var(--gold);border-bottom-color:var(--gold)}
.section{display:none;padding:1rem 1rem 90px;max-width:680px;margin:0 auto}
.section.active{display:block}
.sec-hdr{margin-bottom:1.2rem}
.sec-title{font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;font-weight:600;color:var(--gold)}
.sec-desc{font-size:11px;color:var(--muted);margin-top:2px;letter-spacing:.5px}
.menu-card{background:var(--card);border:.5px solid var(--border);border-radius:14px;overflow:hidden;margin-bottom:12px;transition:border-color .2s}
.menu-card:hover{border-color:var(--gold-dim)}
.card-img{width:100%;height:155px;object-fit:cover;display:block}
.card-img-placeholder{width:100%;height:155px;background:linear-gradient(135deg,#0d1f27,#0b2f3a);display:flex;align-items:center;justify-content:center;font-size:48px}
.card-body{padding:.9rem 1rem}
.card-top{display:flex;justify-content:space-between;align-items:flex-start;gap:10px}
.item-name{font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;font-weight:600;color:var(--text);line-height:1.2}
.item-price{font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;font-weight:700;color:var(--gold);white-space:nowrap;flex-shrink:0}
.item-tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:5px}
.tag{font-size:9px;padding:2px 7px;border-radius:10px;font-weight:500;letter-spacing:.5px;text-transform:uppercase}
.tag-fresh{background:#0a2215;color:#5cba84;border:.5px solid #1d5c3b}
.tag-spicy{background:#2a100a;color:#e07450;border:.5px solid #5c2b1d}
.tag-sushi{background:#0a1530;color:#5090d0;border:.5px solid #1d3a6c}
.tag-grill{background:#1f1200;color:#d09050;border:.5px solid #5c3a0a}
.item-desc{font-size:12px;color:var(--muted);margin-top:5px;line-height:1.55}
.qty-row{display:flex;align-items:center;justify-content:flex-end;gap:10px;margin-top:10px}
.qty-btn{width:30px;height:30px;border-radius:50%;border:1px solid var(--border);background:var(--ocean-mid);color:var(--text);font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;line-height:1}
.qty-btn:hover{border-color:var(--gold);color:var(--gold)}
.qty-num{font-size:15px;font-weight:500;min-width:20px;text-align:center;color:var(--gold)}
.order-bar{position:fixed;bottom:0;left:0;right:0;background:var(--ocean);border-top:1px solid var(--border);padding:12px 1.25rem;display:flex;align-items:center;justify-content:space-between;z-index:100}
.bar-count{font-size:12px;color:var(--muted)}
.bar-count strong{color:var(--text)}
.bar-btn{background:var(--gold);color:var(--ocean);border:none;border-radius:10px;padding:10px 20px;font-size:13px;font-weight:500;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;transition:opacity .2s}
.bar-btn:disabled{opacity:.3;cursor:not-allowed}
.bar-btn:not(:disabled):hover{opacity:.88}
.order-wrap{max-width:680px;margin:0 auto;padding:1rem 1rem 5rem}
.back-btn{background:none;border:none;color:var(--muted);font-size:13px;cursor:pointer;display:flex;align-items:center;gap:5px;margin-bottom:1rem;font-family:system-ui,-apple-system,sans-serif}
.back-btn:hover{color:var(--text)}
.ord-title{font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;color:var(--gold);margin-bottom:1rem}
.order-line{display:flex;justify-content:space-between;align-items:flex-start;padding:10px 0;border-bottom:.5px solid var(--border);gap:10px}
.ol-name{font-size:13px;color:var(--text)}.ol-qty{font-size:11px;color:var(--muted);margin-top:2px}
.ol-price{font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:var(--gold);white-space:nowrap}
.totals-box{background:var(--card);border-radius:12px;padding:1rem;margin-top:1.2rem;border:.5px solid var(--border)}
.t-row{display:flex;justify-content:space-between;font-size:13px;color:var(--muted);padding:4px 0}
.t-row span:last-child{color:var(--text)}
.t-grand{font-size:18px;font-family:Georgia,'Times New Roman',serif;font-weight:700;color:var(--gold);border-top:1px solid var(--border);margin-top:8px;padding-top:12px}
.t-grand span{color:var(--gold)!important}
.tip-section,.special-section{margin-top:1.2rem}
.small-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:9px;display:block}
.tip-grid{display:flex;gap:8px;flex-wrap:wrap}
.tip-btn{flex:1;min-width:55px;padding:9px 6px;border-radius:8px;border:.5px solid var(--border);background:var(--card);color:var(--muted);font-size:12px;cursor:pointer;text-align:center;font-family:system-ui,-apple-system,sans-serif;transition:all .2s}
.tip-btn.active{border-color:var(--gold);color:var(--gold);background:var(--gold-bg)}
.special-input{width:100%;background:var(--card);border:.5px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;padding:10px 12px;resize:none;height:64px;font-family:system-ui,-apple-system,sans-serif}
.special-input::placeholder{color:var(--muted)}
.special-input:focus{outline:none;border-color:var(--gold-dim)}
.place-btn{width:100%;background:var(--gold);color:var(--ocean);border:none;border-radius:12px;padding:15px;font-size:15px;font-weight:500;cursor:pointer;margin-top:1.5rem;letter-spacing:1px;font-family:system-ui,-apple-system,sans-serif;transition:opacity .2s}
.place-btn:hover{opacity:.88}
.place-btn:disabled{opacity:.35;cursor:not-allowed}
#confirm-screen{padding:2.5rem 1.5rem;text-align:center;max-width:480px;margin:0 auto}
.conf-icon{font-size:52px;margin-bottom:1rem}
.conf-title{font-family:Georgia,'Times New Roman',serif;font-size:2rem;color:var(--gold);margin-bottom:8px}
.conf-sub{font-size:13px;color:var(--muted);line-height:1.8}
.conf-num{font-family:Georgia,'Times New Roman',serif;font-size:2.4rem;color:var(--text);margin:1.5rem 0;letter-spacing:2px}
.divider{height:1px;background:linear-gradient(to right,transparent,var(--gold),transparent);opacity:.35;margin:1rem 0}
.conf-box{background:var(--card);border-radius:12px;padding:1rem;text-align:left;border:.5px solid var(--border)}
.c-row{display:flex;justify-content:space-between;font-size:13px;padding:4px 0;color:var(--muted);gap:8px}
.c-row span:last-child{color:var(--text);text-align:right;max-width:60%}
.c-gold span{color:var(--gold)!important;font-family:Georgia,'Times New Roman',serif;font-size:1.05rem}
.new-btn{margin-top:1.5rem;background:none;border:.5px solid var(--border);color:var(--muted);border-radius:12px;padding:12px 24px;font-size:13px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;transition:all .2s}
.new-btn:hover{border-color:var(--gold-dim);color:var(--gold)}
/* PIN */
#staff-login-screen{flex-direction:column;align-items:center;justify-content:center;min-height:100vh;padding:2rem;text-align:center}
#manager-login-screen{flex-direction:column;align-items:center;justify-content:center;min-height:100vh;padding:2rem;text-align:center}
.login-card{background:var(--card);border:.5px solid var(--border);border-radius:16px;padding:2rem 1.5rem;width:100%;max-width:320px}
.login-icon{font-size:36px;margin-bottom:1rem}
.login-title{font-family:Georgia,'Times New Roman',serif;font-size:1.6rem;color:var(--gold);margin-bottom:4px}
.login-sub{font-size:12px;color:var(--muted);margin-bottom:1.5rem;line-height:1.6}
.pin-display{display:flex;gap:10px;justify-content:center;margin-bottom:1.5rem}
.pin-dot{width:14px;height:14px;border-radius:50%;border:1.5px solid var(--border);background:transparent;transition:all .2s}
.pin-dot.filled{background:var(--gold);border-color:var(--gold)}
.pin-pad{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
.pin-key{padding:16px 10px;border-radius:10px;border:.5px solid var(--border);background:var(--ocean-mid);color:var(--text);font-size:20px;font-weight:500;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;transition:all .15s}
.pin-key:hover{border-color:var(--gold-dim);color:var(--gold)}
.pin-error{color:#e07450;font-size:12px;height:18px;margin-bottom:.5rem}
/* STAFF SHELL */
#staff-shell{display:none;min-height:100vh;flex-direction:column}
#staff-shell.active{display:flex!important}
.staff-header{background:var(--ocean);border-bottom:1px solid var(--border);padding:.8rem 1.25rem;display:flex;align-items:center;justify-content:space-between;flex-shrink:0}
.staff-brand{font-family:Georgia,'Times New Roman',serif;font-size:1.2rem;color:var(--gold);letter-spacing:2px}
.staff-tabs{display:flex;background:var(--ocean);border-bottom:1px solid var(--border);flex-shrink:0;overflow-x:auto;scrollbar-width:none}
.staff-tabs::-webkit-scrollbar{display:none}
.staff-tab{flex:1;min-width:75px;padding:13px 6px;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);background:none;border:none;border-bottom:2px solid transparent;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;transition:all .2s;white-space:nowrap}
.staff-tab.active{color:var(--gold);border-bottom-color:var(--gold)}
.staff-panel{display:none;padding:1rem;max-width:780px;margin:0 auto;width:100%}
.staff-panel.active{display:block}
.logout-btn{background:none;border:.5px solid var(--border);color:var(--muted);border-radius:8px;padding:5px 10px;font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif}
.logout-btn:hover{border-color:#7a2d2d;color:#c46a6a}
.live-dot{width:7px;height:7px;background:#3d9a5c;border-radius:50%;display:inline-block;animation:pulse 1.5s infinite}
/* KITCHEN */
.kitchen-toolbar{display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:8px}
.kitchen-title{font-family:Georgia,'Times New Roman',serif;font-size:1.5rem;color:var(--gold)}
.filter-tabs{display:flex;gap:6px;flex-wrap:wrap}
.filter-tab{padding:6px 14px;border-radius:20px;border:.5px solid var(--border);background:var(--card);color:var(--muted);font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;transition:all .2s}
.filter-tab.active{border-color:var(--gold);color:var(--gold);background:var(--gold-bg)}
.refresh-btn{padding:7px 14px;border-radius:8px;border:.5px solid var(--border);background:var(--ocean-mid);color:var(--muted);font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif}
.refresh-btn:hover{border-color:var(--gold-dim);color:var(--text)}
.stats-row{display:flex;gap:10px;margin-bottom:1rem;flex-wrap:wrap}
.stat-card{flex:1;min-width:70px;background:var(--card);border:.5px solid var(--border);border-radius:10px;padding:.8rem;text-align:center}
.stat-num{font-family:Georgia,'Times New Roman',serif;font-size:1.8rem;font-weight:700;color:var(--gold)}
.stat-label{font-size:10px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-top:2px}
.order-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:12px}
.ticket{background:var(--card);border-radius:14px;overflow:hidden;border-left:4px solid var(--border);transition:border-color .3s}
.ticket.status-new{border-left-color:#e07450}
.ticket.status-cooking{border-left-color:var(--gold)}
.ticket.status-ready{border-left-color:#5cba84}
.ticket.status-done{border-left-color:#3a5a6a;opacity:.55}
.ticket-head{padding:.8rem 1rem;display:flex;align-items:flex-start;justify-content:space-between;border-bottom:.5px solid var(--border)}
.ticket-table-num{font-family:Georgia,'Times New Roman',serif;font-size:1.4rem;font-weight:700;color:var(--gold);line-height:1}
.ticket-table-sub{font-size:10px;color:var(--muted);margin-top:2px}
.ticket-meta{text-align:right}
.ticket-id{font-size:11px;color:var(--muted)}
.ticket-time{font-size:12px;color:var(--text);font-weight:500}
.ticket-elapsed{font-size:10px;color:#e07450;margin-top:2px}
.status-pill{display:inline-flex;align-items:center;padding:3px 10px;border-radius:12px;font-size:10px;font-weight:500;letter-spacing:.5px;text-transform:uppercase;margin-top:4px}
.pill-new{background:#2a100a;color:#e07450;border:.5px solid #5c2b1d}
.pill-cooking{background:#1a1500;color:var(--gold);border:.5px solid var(--gold-dim)}
.pill-ready{background:#0a2215;color:#5cba84;border:.5px solid #1d5c3b}
.pill-done{background:#0a1520;color:#3a6a8a;border:.5px solid #1a3a5a}
.ticket-items{padding:.7rem 1rem}
.t-item-row{display:flex;justify-content:space-between;align-items:center;padding:5px 0;border-bottom:.5px solid var(--border);font-size:13px}
.t-item-row:last-child{border:none}
.t-item-name{color:var(--text);display:flex;align-items:center;gap:6px;flex:1}
.t-item-qty{background:var(--ocean-mid);color:var(--gold);border-radius:6px;padding:2px 7px;font-size:11px;font-weight:500;flex-shrink:0}
.t-item-price{color:var(--muted);font-size:12px;flex-shrink:0;margin-left:6px}
.ticket-note{margin:.3rem 1rem .6rem;background:#1f1200;border:.5px solid #5c3a0a;border-radius:8px;padding:6px 10px;font-size:11px;color:#d09050}
.ticket-footer{padding:.8rem 1rem;border-top:.5px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:8px;flex-wrap:wrap}
.ticket-total{font-family:Georgia,'Times New Roman',serif;font-size:1.15rem;color:var(--gold);font-weight:600}
.action-btns{display:flex;gap:6px;flex-wrap:wrap}
.act-btn{padding:7px 12px;border-radius:8px;border:none;font-size:11px;font-weight:500;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;transition:all .15s;white-space:nowrap}
.act-btn:hover{opacity:.8}
.btn-start{background:#1a3a0a;color:#78c46a;border:.5px solid #2d6a1a}
.btn-ready{background:#1a2a00;color:var(--gold);border:.5px solid var(--gold-dim)}
.btn-done{background:#0a1a2a;color:#5090d0;border:.5px solid #1a3a6a}
.btn-cancel{background:#2a0a0a;color:#d07070;border:.5px solid #5a1a1a}
.no-orders{text-align:center;padding:3rem 1rem;color:var(--muted);grid-column:1/-1}
.no-orders-icon{font-size:40px;margin-bottom:1rem;opacity:.4}
/* ADMIN */
.admin-section-title{font-family:Georgia,'Times New Roman',serif;font-size:1.4rem;color:var(--gold);margin-bottom:1rem}
.admin-form{background:var(--card);border:.5px solid var(--border);border-radius:12px;padding:1.2rem}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.form-row{margin-bottom:10px}
.form-label{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:5px;display:block}
.form-input,.form-select,.form-textarea{width:100%;background:var(--surface);border:.5px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;padding:9px 11px;font-family:system-ui,-apple-system,sans-serif}
.form-input:focus,.form-select:focus,.form-textarea:focus{outline:none;border-color:var(--gold-dim)}
.form-select option{background:var(--surface)}
.form-textarea{resize:none;height:68px}
.tag-checks{display:flex;gap:12px;flex-wrap:wrap;margin-top:4px}
.tag-check{display:flex;align-items:center;gap:5px;font-size:12px;color:var(--muted);cursor:pointer}
.add-item-btn{width:100%;background:var(--gold);color:var(--ocean);border:none;border-radius:10px;padding:12px;font-size:14px;font-weight:500;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;margin-top:10px}
.add-item-btn:hover{opacity:.88}
.admin-item-card{background:var(--card);border:.5px solid var(--border);border-radius:10px;padding:.8rem 1rem;margin-bottom:8px;display:flex;align-items:center;gap:10px}
.ai-emoji{font-size:22px;flex-shrink:0}
.ai-info{flex:1;min-width:0}
.ai-name{font-size:13px;font-weight:500;color:var(--text)}
.ai-sub{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.ai-price{font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:var(--gold);flex-shrink:0}
.del-btn{background:none;border:.5px solid #5c1a1a;color:#c46a6a;border-radius:6px;padding:4px 10px;font-size:11px;cursor:pointer;flex-shrink:0}
.del-btn:hover{background:#1a0a0a}
/* QR */
.qr-wrap{max-width:420px;margin:0 auto;text-align:center;padding:1rem}
.qr-title{font-family:Georgia,'Times New Roman',serif;font-size:1.4rem;color:var(--gold);margin-bottom:.5rem}
.qr-sub{font-size:12px;color:var(--muted);margin-bottom:1.2rem;line-height:1.7}
.qr-table-grid{display:flex;gap:7px;flex-wrap:wrap;justify-content:center;margin-bottom:1.2rem}
.qr-tbl-btn{padding:7px 14px;border-radius:8px;border:.5px solid var(--border);background:var(--card);color:var(--muted);font-size:12px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;transition:all .2s}
.qr-tbl-btn.active{border-color:var(--gold);color:var(--gold);background:var(--gold-bg)}
.qr-canvas-wrap{background:#fff;border-radius:12px;border:3px solid var(--gold);display:inline-block;padding:10px;margin-bottom:1rem}
.qr-dl-btn{display:inline-block;background:var(--gold);color:var(--ocean);border:none;border-radius:10px;padding:10px 22px;font-size:13px;font-weight:500;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;margin-top:.5rem}
.qr-dl-btn:hover{opacity:.88}
.qr-url{font-size:10px;color:var(--muted);margin-top:.8rem;word-break:break-all;line-height:1.5}
/* SETUP GUIDE */
.guide-card{background:var(--card);border:.5px solid var(--border);border-radius:12px;padding:1rem 1.2rem;margin-bottom:10px}
.guide-num{font-family:Georgia,'Times New Roman',serif;font-size:2rem;color:var(--gold);opacity:.35;float:right;line-height:1}
.guide-heading{font-size:14px;font-weight:500;color:var(--text);margin-bottom:5px}
.guide-body{font-size:12px;color:var(--muted);line-height:1.8}
.guide-code{background:#0a0d0e;border:.5px solid var(--border);border-radius:6px;padding:8px 12px;font-size:11px;color:#78c46a;font-family:monospace;margin:6px 0;word-break:break-all;display:block}
.guide-highlight{color:var(--gold);font-weight:500}
.guide-green{color:#5cba84;font-weight:500}
.guide-section-label{font-size:10px;letter-spacing:3px;text-transform:uppercase;color:var(--muted);margin:1.5rem 0 .8rem;padding-bottom:6px;border-bottom:.5px solid var(--border)}
@keyframes fadeUp{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
.menu-card,.ticket,.admin-item-card,.guide-card{animation:fadeUp .22s ease both}
/* REPORT */
.rpt-kpi{background:var(--card);border:.5px solid var(--border);border-radius:12px;padding:.9rem 1rem;text-align:center}
.rpt-kpi-num{font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;font-weight:700;color:var(--gold)}
.rpt-kpi-label{font-size:10px;color:var(--muted);letter-spacing:1px;text-transform:uppercase;margin-top:3px}
.rpt-item-row{display:flex;align-items:center;gap:10px;padding:7px 0;border-bottom:.5px solid var(--border)}
.rpt-item-row:last-child{border:none}
.rpt-item-bar-wrap{flex:1;background:var(--ocean-mid);border-radius:4px;height:6px;overflow:hidden}
.rpt-item-bar{height:100%;background:var(--gold);border-radius:4px;transition:width .4s ease}
.rpt-hour-row{display:flex;align-items:center;gap:8px;padding:5px 0;font-size:12px}
.rpt-hour-bar-wrap{flex:1;background:var(--ocean-mid);border-radius:4px;height:8px;overflow:hidden}
.rpt-hour-bar{height:100%;background:#0b5a78;border-radius:4px;transition:width .4s ease}
.rpt-ord-row{display:flex;justify-content:space-between;align-items:flex-start;padding:9px 0;border-bottom:.5px solid var(--border);gap:8px;font-size:12px}
.rpt-ord-row:last-child{border:none}
.rpt-status-pill{display:inline-block;padding:2px 8px;border-radius:10px;font-size:10px;font-weight:500;text-transform:uppercase;letter-spacing:.5px}
input[type="date"]::-webkit-calendar-picker-indicator{filter:invert(0.6)}
/* MANAGER */
.mgr-tab.active{color:#6dd98a!important;border-bottom-color:#6dd98a!important}
.mgr-kpi{background:#0a1a10;border:.5px solid #1e4030;border-radius:12px;padding:.9rem 1rem;text-align:center}
.mgr-kpi-num{font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;font-weight:700;color:#6dd98a}
.mgr-kpi-label{font-size:10px;color:#3a7a50;letter-spacing:1px;text-transform:uppercase;margin-top:3px}
.mgr-bar-wrap{flex:1;background:#0d2a18;border-radius:4px;height:7px;overflow:hidden}
.mgr-bar{height:100%;background:#3d9a5c;border-radius:4px;transition:width .4s ease}
.mgr-item-card{background:#0a1a10;border:.5px solid #1e4030;border-radius:12px;padding:.9rem 1rem;margin-bottom:8px;display:flex;align-items:center;gap:12px}

/* ══════════════════════════════════════
   COVER SCREEN — splash cover + dive-in
   ══════════════════════════════════════ */
.cover-screen{position:fixed;inset:0;z-index:1000;display:flex;flex-direction:column;background:linear-gradient(180deg,#f7eedd 0%,#f1e3c8 55%,#e7d6b0 100%);overflow:hidden}
.cover-paper{position:relative;z-index:2;flex:1 1 auto;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:7vh 1.5rem 0;animation:cover-in .9s ease both}
.cover-mark{width:64px;height:64px;margin:0 auto 14px;animation:cover-float 5s ease-in-out infinite}
.cover-mark svg{width:100%;height:100%;display:block}
.cover-brand{font-family:Georgia,'Times New Roman',serif;font-weight:700;font-size:2.3rem;letter-spacing:5px;color:#1c140f}
.cover-brand-sub{font-family:system-ui,-apple-system,sans-serif;font-size:10px;letter-spacing:4px;text-transform:uppercase;color:#5a4a32;margin-top:3px}
.cover-headline{margin-top:2rem;font-family:'Anton',Impact,sans-serif;font-size:clamp(2.4rem,10.5vw,3.4rem);line-height:.9;color:#181009;text-transform:uppercase;letter-spacing:-.5px;transform:skewX(-5deg)}
.cover-headline span{display:block}
.cover-tagline{font-family:'Caveat',cursive;font-weight:600;font-size:1.7rem;color:#3c2f1c;margin-top:.6rem}
.cover-menu-wrap{position:relative;z-index:5;display:flex;justify-content:center;margin-top:1.4rem}
.cover-menu-btn{position:relative;width:98px;height:98px;border-radius:50%;transform:translateY(44px);background:radial-gradient(circle at 34% 30%,#ecd08a,var(--gold) 58%,var(--gold-dim) 100%);border:3px solid #1c140f;display:flex;align-items:center;justify-content:center;font-family:Georgia,'Times New Roman',serif;font-weight:700;font-size:14px;letter-spacing:3px;color:#1c140f;cursor:pointer;box-shadow:0 8px 22px rgba(20,14,8,.3);-webkit-tap-highlight-color:transparent}
.cover-menu-btn:active{transform:translateY(44px) scale(.94)}
.cover-menu-ring{position:absolute;inset:-10px;border-radius:50%;border:2px solid var(--gold);opacity:.6;animation:menu-ring 2.6s ease-out infinite}
@keyframes menu-ring{0%{transform:scale(.9);opacity:.65}100%{transform:scale(1.4);opacity:0}}
@keyframes cover-in{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
@keyframes cover-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}

.cover-horizon{position:relative;z-index:1;height:32vh;min-height:190px;max-height:280px;flex-shrink:0;overflow:hidden}
.cover-sky{position:absolute;top:0;left:0;width:100%;height:48%;z-index:1;overflow:hidden}
.bird{animation:bird-drift 16s linear infinite}
.bird-2{animation-duration:21s;animation-delay:-7s;opacity:.7}
@keyframes bird-drift{from{transform:translateX(-15%)}to{transform:translateX(115%)}}
.cover-palms{position:absolute;left:0;bottom:0;width:58%;height:100%;z-index:6;pointer-events:none}
.palm{position:absolute;bottom:-4%}
.palm-left{left:-8%;width:64%}
.palm-right{left:24%;width:46%;opacity:.75}
.frond{transform-origin:84px 38px;animation:frond-sway 4.6s ease-in-out infinite}
.frond-r{transform-origin:82px 52px}
.palm-svg g:nth-child(2) .frond{animation-delay:-.9s}
.palm-svg g:nth-child(3) .frond{animation-delay:-1.8s}
.palm-svg g:nth-child(4) .frond{animation-delay:-2.7s}
.palm-svg g:nth-child(5) .frond{animation-delay:-3.5s}
.palm-svg g:nth-child(6) .frond{animation-delay:-4.1s}
@keyframes frond-sway{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}}
.cover-boat{position:absolute;right:13%;bottom:38%;width:78px;z-index:4;animation:boat-bob 4s ease-in-out infinite}
@keyframes boat-bob{0%,100%{transform:translateY(0) rotate(-1.4deg)}50%{transform:translateY(-7px) rotate(1.4deg)}}
.cover-waves{position:absolute;left:0;bottom:0;width:100%;height:64%;z-index:3;overflow:hidden}
.wave-layer{position:absolute;left:0;top:0;width:200%;height:100%;display:block}
.wave-back{z-index:1;opacity:.5;animation:wave-drift 22s linear infinite}
.wave-mid{z-index:2;opacity:.8;animation:wave-drift-rev 15s linear infinite}
.wave-front{z-index:5;animation:wave-drift 10s linear infinite}
@keyframes wave-drift{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes wave-drift-rev{from{transform:translateX(-50%)}to{transform:translateX(0)}}

.tide-overlay{position:absolute;inset:0;background:var(--ocean);transform:translateY(100%);transition:transform .85s cubic-bezier(.65,0,.2,1);z-index:50}
.cover-screen.diving .tide-overlay{transform:translateY(0)}
.cover-screen.diving .cover-paper,.cover-screen.diving .cover-horizon{animation:none;transition:opacity .35s ease;opacity:0;pointer-events:none}

@media (max-width:380px){
  .cover-brand{font-size:1.95rem;letter-spacing:4px}
  .cover-headline{font-size:clamp(2.05rem,11.5vw,2.7rem)}
  .cover-menu-btn{width:84px;height:84px;font-size:12px;transform:translateY(38px)}
  .cover-menu-btn:active{transform:translateY(38px) scale(.94)}
}
@media (prefers-reduced-motion:reduce){
  .cover-mark,.frond,.cover-boat,.wave-back,.wave-mid,.wave-front,.bird,.cover-menu-ring{animation:none!important}
}
</style>
</head>
<body>

<!-- ══ COVER ══ -->
<div id="cover-screen" class="cover-screen">
  <div class="cover-paper">
    <div class="cover-mark">
      <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <rect x="5" y="5" width="90" height="90" fill="none" stroke="#1c140f" stroke-width="5"/>
        <g transform="translate(2,6)">
          <path d="M14,46 C14,30 30,19 50,19 C66,19 79,27 88,38 L75,38 L88,46 L75,54 C79,65 66,73 50,73 C30,73 14,62 14,46 Z" fill="#1c140f"/>
          <path d="M44,19 L52,5 L59,20 Z" fill="#1c140f"/>
          <circle cx="28" cy="38" r="4.2" fill="#f7eedd"/>
        </g>
      </svg>
    </div>
    <div class="cover-brand" id="cv-brand">DAR</div>
    <div class="cover-brand-sub" id="cv-brand-sub">Fish Market</div>
    <h1 class="cover-headline"><span id="cv-h1">Same Ocean</span><span id="cv-h2">New Wave</span></h1>
    <p class="cover-tagline" id="cv-tagline">…Food Menu…</p>
    <div class="cover-menu-wrap">
      <button class="cover-menu-btn" onclick="enterApp()" aria-label="Open menu">
        <span class="cover-menu-ring"></span>MENU
      </button>
    </div>
  </div>

  <div class="cover-horizon">
    <svg class="cover-sky" viewBox="0 0 400 60" preserveAspectRatio="none" aria-hidden="true">
      <path class="bird bird-1" d="M0,14 L7,5 L14,14 L21,5 L28,14" stroke="#1c140f" stroke-width="1.4" fill="none" stroke-linecap="round" opacity=".55"/>
      <path class="bird bird-2" d="M0,30 L6,23 L12,30 L18,23 L24,30" stroke="#1c140f" stroke-width="1.4" fill="none" stroke-linecap="round" opacity=".5"/>
    </svg>

    <div class="cover-palms">
      <svg class="palm palm-svg palm-left" viewBox="0 0 140 220" aria-hidden="true">
        <path d="M62,220 C58,175 50,135 60,95 C66,72 76,55 84,38" stroke="#1c140f" stroke-width="8" fill="none" stroke-linecap="round" opacity=".5"/>
        <g transform="rotate(-52 84 38)"><path class="frond" d="M84,38 C66,20 36,16 14,28 C38,30 58,36 76,48 Z" fill="#1c140f" opacity=".45"/></g>
        <g transform="rotate(-22 84 38)"><path class="frond" d="M84,38 C66,16 36,10 12,18 C38,24 60,32 78,46 Z" fill="#1c140f" opacity=".45"/></g>
        <g transform="rotate(8 84 38)"><path class="frond" d="M84,38 C70,14 42,6 18,12 C42,20 64,28 80,44 Z" fill="#1c140f" opacity=".45"/></g>
        <g transform="rotate(38 84 38)"><path class="frond" d="M84,38 C76,16 54,4 30,6 C50,16 68,26 80,42 Z" fill="#1c140f" opacity=".45"/></g>
        <g transform="rotate(66 84 38)"><path class="frond" d="M84,38 C82,14 66,0 44,-2 C58,12 72,24 80,40 Z" fill="#1c140f" opacity=".45"/></g>
      </svg>
      <svg class="palm palm-svg palm-right" viewBox="0 0 140 220" aria-hidden="true">
        <path d="M62,220 C58,180 52,142 60,104 C65,84 74,68 82,52" stroke="#1c140f" stroke-width="7" fill="none" stroke-linecap="round" opacity=".4"/>
        <g transform="rotate(-48 82 52)"><path class="frond frond-r" d="M82,52 C66,36 40,32 20,42 C42,44 60,50 76,60 Z" fill="#1c140f" opacity=".35"/></g>
        <g transform="rotate(-16 82 52)"><path class="frond frond-r" d="M82,52 C66,32 40,26 18,32 C42,38 62,46 78,58 Z" fill="#1c140f" opacity=".35"/></g>
        <g transform="rotate(16 82 52)"><path class="frond frond-r" d="M82,52 C70,30 46,22 24,28 C46,36 64,44 78,58 Z" fill="#1c140f" opacity=".35"/></g>
        <g transform="rotate(48 82 52)"><path class="frond frond-r" d="M82,52 C76,32 58,22 36,24 C54,34 70,42 78,56 Z" fill="#1c140f" opacity=".35"/></g>
      </svg>
    </div>

    <svg class="cover-boat" viewBox="0 0 100 130" aria-hidden="true">
      <path d="M10,108 C10,118 28,124 50,124 C72,124 90,118 90,108 L80,98 L20,98 Z" fill="#1c140f" opacity=".5"/>
      <line x1="50" y1="98" x2="50" y2="14" stroke="#1c140f" stroke-width="2.4" opacity=".5"/>
      <path d="M52,18 L86,92 L52,92 Z" fill="#1c140f" opacity=".22"/>
      <path d="M48,40 L20,92 L48,92 Z" fill="#1c140f" opacity=".22"/>
    </svg>

    <div class="cover-waves">
      <svg class="wave-layer wave-back" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,70 Q125,95 250,70 T500,70 T750,70 T1000,70 L1000,200 L0,200 Z" fill="var(--ocean-mid)"/>
      </svg>
      <svg class="wave-layer wave-mid" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,100 Q125,132 250,100 T500,100 T750,100 T1000,100 L1000,200 L0,200 Z" fill="var(--ocean)"/>
      </svg>
      <svg class="wave-layer wave-front" viewBox="0 0 1000 200" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0,130 Q125,160 250,130 T500,130 T750,130 T1000,130 L1000,200 L0,200 Z" fill="#082530"/>
      </svg>
    </div>
  </div>

  <div class="tide-overlay"></div>
</div>

<!-- ══ CUSTOMER: MENU ══ -->
<div id="menu-screen" class="screen active">
  <header>
    <div class="brand" id="hdr-brand">Dar Fish Market</div>
    <div class="brand-sub" id="hdr-brand-sub">180msasani · Dar es Salaam · New wave</div>
    <div class="badge-row">
      <div class="badge">📍 Meza <strong id="table-display">1</strong></div>
      <div class="badge">🙋 <strong id="waiter-display">helper</strong></div>
      <div class="badge"><span class="conn-dot offline" id="conn-dot"></span><strong id="conn-label">Connecting…</strong></div>
      <div class="badge" id="pending-badge" style="display:none;background:rgba(200,168,75,.18);border-color:var(--gold-dim)"></div>
    </div>
  </header>
  <div class="tabs-wrap">
    <div class="tabs">
      <button class="tab-btn active" onclick="showTab('starters',this)">Starters</button>
      <button class="tab-btn" onclick="showTab('mains',this)">Main Course</button>
      <button class="tab-btn" onclick="showTab('sushi',this)">Sushi & Raw</button>
      <button class="tab-btn" onclick="showTab('desserts',this)">Desserts</button>
      <button class="tab-btn" onclick="showTab('drinks',this)">Drinks</button>
    </div>
  </div>
  <div id="starters" class="section active"><div class="sec-hdr"><div class="sec-title">Starters</div><div class="sec-desc">Fresh bites to begin your coastal journey</div></div></div>
  <div id="mains" class="section"><div class="sec-hdr"><div class="sec-title">Main Course</div><div class="sec-desc">Caught this morning, cooked with heart</div></div></div>
  <div id="sushi" class="section"><div class="sec-hdr"><div class="sec-title">Sushi & Raw Bar</div><div class="sec-desc">Japanese-inspired, Indian Ocean fresh</div></div></div>
  <div id="desserts" class="section"><div class="sec-hdr"><div class="sec-title">Desserts — Vitamu</div><div class="sec-desc">Sweet coastal endings</div></div></div>
  <div id="drinks" class="section"><div class="sec-hdr"><div class="sec-title">Drinks — Vinywaji</div><div class="sec-desc">Cold, fresh & local favourites</div></div></div>
  <div class="order-bar">
    <div class="bar-count" id="bar-count">No items selected</div>
    <button class="bar-btn" id="view-btn" onclick="goToOrder()" disabled>View Order →</button>
  </div>
</div>

<!-- ══ CUSTOMER: ORDER ══ -->
<div id="order-screen" class="screen">
  <header style="text-align:left;padding:.9rem 1.25rem .7rem">
    <div class="brand" style="font-size:1.4rem">Your Order</div>
  </header>
  <div class="order-wrap">
    <button class="back-btn" onclick="showCustomerScreen('menu-screen')">← Back to menu</button>
    <div id="order-lines"></div>
    <div class="tip-section">
      <span class="small-label">Add a gratuity</span>
      <div class="tip-grid">
        <button class="tip-btn" onclick="setTip(0,this)">No tip</button>
        <button class="tip-btn" onclick="setTip(10,this)">10%</button>
        <button class="tip-btn active" onclick="setTip(15,this)">15%</button>
        <button class="tip-btn" onclick="setTip(20,this)">20%</button>
        <button class="tip-btn" onclick="setTip(25,this)">25%</button>
      </div>
    </div>
    <div class="totals-box" id="totals-box"></div>
    <div class="special-section">
      <span class="small-label">Special Requests / Maombi Maalum</span>
      <textarea class="special-input" id="special-req" placeholder="Allergies, spice level, dietary needs..."></textarea>
    </div>
    <button class="place-btn" id="place-btn" onclick="placeOrder()">Tuma Agizo — Place Order</button>
  </div>
</div>

<!-- ══ CUSTOMER: CONFIRM ══ -->
<div id="confirm-screen" class="screen">
  <div class="conf-icon">🐟</div>
  <div class="conf-title">Agizo Limepokelewa!</div>
  <div class="conf-sub">Your order has been sent to the kitchen.<br>Mwandishi wako amearifiwa — your waiter is on it!</div>
  <div class="conf-num" id="conf-num">#DFM-0000</div>
  <div class="divider"></div>
  <div class="conf-box" id="conf-detail"></div>
  <button class="new-btn" onclick="resetOrder()">Order something else</button>
</div>

<!-- ══ STAFF: PIN ══ -->
<div id="staff-login-screen" class="screen-flex" style="display:none">
  <div class="login-card">
    <div class="login-icon">🔒</div>
    <div class="login-title">Staff Access</div>
    <div class="login-sub">Enter your 6-digit PIN to access<br>the kitchen & admin panel</div>
    <div class="pin-error" id="pin-error">&nbsp;</div>
    <div class="pin-display">
      <div class="pin-dot" id="pd0"></div><div class="pin-dot" id="pd1"></div>
      <div class="pin-dot" id="pd2"></div><div class="pin-dot" id="pd3"></div>
      <div class="pin-dot" id="pd4"></div><div class="pin-dot" id="pd5"></div>
    </div>
    <div class="pin-pad">
      <button class="pin-key" onclick="pinPress('1')">1</button>
      <button class="pin-key" onclick="pinPress('2')">2</button>
      <button class="pin-key" onclick="pinPress('3')">3</button>
      <button class="pin-key" onclick="pinPress('4')">4</button>
      <button class="pin-key" onclick="pinPress('5')">5</button>
      <button class="pin-key" onclick="pinPress('6')">6</button>
      <button class="pin-key" onclick="pinPress('7')">7</button>
      <button class="pin-key" onclick="pinPress('8')">8</button>
      <button class="pin-key" onclick="pinPress('9')">9</button>
      <button class="pin-key" onclick="pinBack()">⌫</button>
      <button class="pin-key" onclick="pinPress('0')">0</button>
      <button class="pin-key" style="font-size:12px;color:var(--muted)" onclick="cancelStaffLogin()">Cancel</button>
    </div>
    <div style="margin-top:1.2rem;border-top:.5px solid var(--border);padding-top:1rem">
      <button onclick="openManagerLogin()" style="width:100%;background:none;border:.5px solid #1e4030;border-radius:10px;padding:10px;font-size:12px;color:#3a7a50;cursor:pointer;font-family:system-ui,-apple-system,sans-serif;display:flex;align-items:center;justify-content:center;gap:6px;transition:all .2s" onmouseover="this.style.borderColor='#6dd98a';this.style.color='#6dd98a'" onmouseout="this.style.borderColor='#1e4030';this.style.color='#3a7a50'">
        👔 Manager Access
      </button>
    </div>
  </div>
</div>

<!-- ══ STAFF: SHELL ══ -->
<div id="staff-shell">
  <div class="staff-header">
    <div class="staff-brand" id="staff-panel-title">DFM Staff Panel</div>
    <div style="display:flex;align-items:center;gap:8px">
      <div style="font-size:11px;color:var(--muted);display:flex;align-items:center;gap:5px"><span class="live-dot"></span>Live</div>
      <button class="logout-btn" onclick="staffLogout()">🔒 Lock</button>
    </div>
  </div>
  <div class="staff-tabs">
    <button class="staff-tab active" onclick="showStaffPanel('kitchen-panel',this)">🍳 Kitchen</button>
    <button class="staff-tab" onclick="showStaffPanel('waiter-panel',this)">🙋 Waiter</button>
    <button class="staff-tab" onclick="showStaffPanel('admin-panel',this)">⚙️ Menu</button>
    <button class="staff-tab" onclick="showStaffPanel('qr-panel',this)">📱 QR Codes</button>
    <button class="staff-tab" onclick="showStaffPanel('guide-panel',this)">📖 Setup Guide</button>
    <button class="staff-tab" onclick="showStaffPanel('tables-panel',this)">🪑 Tables</button>
    <button class="staff-tab" onclick="showStaffPanel('report-panel',this);renderReport()">📊 Reports</button>
  </div>

  <!-- KITCHEN -->
  <div id="kitchen-panel" class="staff-panel active">
    <div class="kitchen-toolbar">
      <div class="kitchen-title">Kitchen Display</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <div class="filter-tabs">
          <button class="filter-tab active" onclick="setKFilter('all',this)">All Active</button>
          <button class="filter-tab" onclick="setKFilter('new',this)">🔴 New</button>
          <button class="filter-tab" onclick="setKFilter('cooking',this)">🟡 Cooking</button>
          <button class="filter-tab" onclick="setKFilter('ready',this)">🟢 Ready</button>
        </div>
        <button class="refresh-btn" onclick="renderKitchen()">⟳ Refresh</button>
      </div>
    </div>
    <div class="stats-row" id="kitchen-stats"></div>
    <div class="order-grid" id="kitchen-grid"></div>
  </div>

  <!-- WAITER -->
  <div id="waiter-panel" class="staff-panel">
    <div class="kitchen-toolbar">
      <div class="kitchen-title">Orders to Serve</div>
      <button class="refresh-btn" onclick="renderWaiter()">⟳ Refresh</button>
    </div>
    <div class="order-grid" id="waiter-grid"></div>
  </div>

  <!-- ADMIN -->
  <div id="admin-panel" class="staff-panel">
    <div class="admin-section-title">Add Menu Item</div>
    <div class="admin-form">
      <div class="form-grid">
        <div class="form-row"><label class="form-label">Item Name</label><input class="form-input" id="f-name" placeholder="e.g. Grilled Snapper"></div>
        <div class="form-row"><label class="form-label">Category</label>
          <select class="form-select" id="f-cat">
            <option value="starters">Starters</option><option value="mains">Main Course</option>
            <option value="sushi">Sushi & Raw</option><option value="desserts">Desserts</option><option value="drinks">Drinks</option>
          </select>
        </div>
      </div>
      <div class="form-grid">
        <div class="form-row"><label class="form-label">Price (TSh)</label><input class="form-input" id="f-price" type="number" placeholder="35000"></div>
        <div class="form-row"><label class="form-label">Emoji</label><input class="form-input" id="f-emoji" placeholder="🐟"></div>
      </div>
      <div class="form-row"><label class="form-label">Description</label><textarea class="form-textarea" id="f-desc" placeholder="Short description..."></textarea></div>
      <div class="form-row"><label class="form-label">Photo URL (paste an image link)</label><input class="form-input" id="f-img" placeholder="https://images.unsplash.com/..."></div>
      <div class="form-row">
        <label class="form-label">Tags</label>
        <div class="tag-checks">
          <label class="tag-check"><input type="checkbox" id="f-fresh"> ✦ Fresh</label>
          <label class="tag-check"><input type="checkbox" id="f-spicy"> 🌶 Spicy</label>
          <label class="tag-check"><input type="checkbox" id="f-sushi"> 🍣 Sushi</label>
          <label class="tag-check"><input type="checkbox" id="f-grill"> 🔥 Grill</label>
        </div>
      </div>
      <button class="add-item-btn" onclick="addMenuItem()">+ Add to Menu</button>
    </div>
    <div style="margin-top:1.5rem">
      <span class="small-label">All Menu Items (<span id="item-count">0</span>)</span>
      <div id="admin-list-items" style="margin-top:.8rem"></div>
    </div>
  </div>

  <!-- QR CODES -->
  <div id="qr-panel" class="staff-panel">
    <div class="qr-wrap">
      <div class="qr-title">Table QR Codes</div>
      <div class="qr-sub">Select a table → download the QR image → print, laminate & stick on the table.<br><strong style="color:var(--text)">Customers scan it → menu opens with their table number.</strong></div>
      <div class="qr-table-grid" id="qr-table-grid"></div>
      <div style="margin:0 0 1rem">
        <input type="text" id="qr-custom-table" class="form-input" maxlength="12"
               placeholder="Or type a custom table name — e.g. VIP-1, Terrace-3"
               style="text-align:center">
      </div>
      <div class="qr-canvas-wrap"><canvas id="qr-canvas" width="220" height="220"></canvas></div>
      <br>
      <button class="qr-dl-btn" onclick="downloadQR()">⬇ Download PNG — Table <span id="qr-dl-label">1</span></button>
      <div class="qr-url" id="qr-url-text"></div>
    </div>
  </div>

  <!-- SETUP GUIDE -->
  <div id="guide-panel" class="staff-panel">
    <div style="max-width:600px;margin:0 auto">
      <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.6rem;color:var(--gold);margin-bottom:.3rem">Hosting & Firebase Setup</div>
      <div style="font-size:12px;color:var(--muted);margin-bottom:1.5rem">Follow these steps once to go live. Free forever.</div>

      <div class="guide-section-label">Step 1 — Upload to GitHub Pages (Free Hosting)</div>
      <div class="guide-card"><div class="guide-num">1</div><div class="guide-heading">Open GitHub on your phone browser</div><div class="guide-body">Go to <span class="guide-highlight">github.com</span> → tap the <strong>+</strong> button → <strong>New repository</strong></div></div>
      <div class="guide-card"><div class="guide-num">2</div><div class="guide-heading">Create the repository</div><div class="guide-body">Name it <span class="guide-highlight">dfm-menu</span> · Set to <strong>Public</strong> · Tick <strong>"Add a README file"</strong> · Tap <strong>Create repository</strong></div></div>
      <div class="guide-card"><div class="guide-num">3</div><div class="guide-heading">Upload this HTML file</div><div class="guide-body">Inside the repo tap <strong>Add file → Upload files</strong> → choose this downloaded HTML file → rename it <span class="guide-highlight">index.html</span> → tap <strong>Commit changes</strong></div></div>
      <div class="guide-card"><div class="guide-num">4</div><div class="guide-heading">Turn on GitHub Pages</div><div class="guide-body">Tap <strong>Settings</strong> (top of repo) → scroll to <strong>Pages</strong> → under Source choose <strong>main branch</strong> → tap Save.<br><br>Your live URL will be:<br><span class="guide-code">https://YOUR-GITHUB-USERNAME.github.io/dfm-menu/</span>Wait 2 minutes then open that URL — your menu is live! 🎉</div></div>

      <div class="guide-section-label">Step 2 — Connect Firebase (Real-Time Orders)</div>
      <div class="guide-card"><div class="guide-num">5</div><div class="guide-heading">Create a free Firebase project</div><div class="guide-body">Go to <span class="guide-highlight">console.firebase.google.com</span> → <strong>Add project</strong> → name it <span class="guide-highlight">dfm-menu</span> → skip Analytics → Create project</div></div>
      <div class="guide-card"><div class="guide-num">6</div><div class="guide-heading">Add a Web App</div><div class="guide-body">In Firebase console tap the <strong>&lt;/&gt;</strong> (Web) icon → nickname it <span class="guide-highlight">DFM Menu</span> → tap Register app → you will see your config object like this:<br><span class="guide-code">apiKey: "AIza..."<br>authDomain: "dfm-menu-xxxx.firebaseapp.com"<br>databaseURL: "https://dfm-menu-xxxx-default-rtdb..."<br>projectId: "dfm-menu-xxxx"</span>Copy all of it.</div></div>
      <div class="guide-card"><div class="guide-num">7</div><div class="guide-heading">Enable Realtime Database</div><div class="guide-body">In Firebase sidebar → <strong>Build → Realtime Database → Create Database</strong> → choose any location → start in <strong>Test mode</strong> → Enable</div></div>
      <div class="guide-card"><div class="guide-num">8</div><div class="guide-heading">Paste config into this file</div><div class="guide-body">Open the HTML file in a text editor (on phone: use <span class="guide-highlight">Acode</span> app — free on Play Store) → find this section near the top of the JavaScript:<br><span class="guide-code">const FIREBASE_CONFIG = {<br>  apiKey: "PASTE_YOUR_API_KEY_HERE",<br>  ...</span>Replace the placeholder values with YOUR config values → save the file → re-upload to GitHub (same steps as Step 3 above) → commit</div></div>
      <div class="guide-card"><div class="guide-num">9</div><div class="guide-heading">Done! Test it</div><div class="guide-body"><span class="guide-green">✓</span> Open the live URL on your phone (customer view)<br><span class="guide-green">✓</span> Open the same URL on another phone or tablet (staff view — tap bottom-right corner 5× → PIN 1234, manager 8× → PIN 5678)<br><span class="guide-green">✓</span> Place a test order on the customer phone<br><span class="guide-green">✓</span> Watch it appear instantly on the staff tablet!<br><br><strong style="color:var(--text)">⚠ Change both PINs before going live</strong> — PINs are now stored as secure hashes, not plain text, so they can't be read from page source. To set a new PIN: open this live page, open browser dev tools console, run <span class="guide-code">await sha256('your-new-pin')</span>, copy the printed hash, then paste it as STAFF_PIN_HASH or MANAGER_PIN_HASH in the file.</div></div>
      <div class="guide-card"><div class="guide-num">10</div><div class="guide-heading">⚠ Lock down Firebase database rules</div><div class="guide-body">Test mode leaves your database open to anyone who finds the project URL. In Firebase console → <strong>Realtime Database → Rules</strong> tab, replace with:<br><span class="guide-code">{<br>  "rules": {<br>    "orders": { ".read": true, ".write": true },<br>    "menu": { ".read": true, ".write": "auth != null" }<br>  }<br>}</span>This keeps ordering working for customers while restricting menu edits. For full production use with multiple staff accounts, enable Firebase Authentication and scope write access to logged-in staff only — ask your developer to set this up before processing real payments.</div></div>

      <div class="guide-section-label">QR Codes — Print for Each Table</div>
      <div class="guide-card"><div class="guide-num">★</div><div class="guide-heading">Generate & print QR codes</div><div class="guide-body">Go to the <strong>QR Codes tab</strong> above → select Table 1 → tap Download PNG → send to a print shop or print yourself.<br>Repeat for each table. The QR URL will be:<br><span class="guide-code">https://YOUR-USERNAME.github.io/dfm-menu/?table=1&waiter=Amina</span>Change <span class="guide-highlight">waiter=Amina</span> to your waiter's real name for each table's QR if you want.</div></div>
    </div>
  </div>
</div>

  <!-- TABLE MANAGER PANEL -->
  <div id="tables-panel" class="staff-panel">
    <div style="max-width:680px;margin:0 auto">
      <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1rem;flex-wrap:wrap;gap:8px">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.5rem;color:var(--gold)">Table Manager</div>
        <button onclick="document.getElementById('tm-add-form').style.display=document.getElementById('tm-add-form').style.display==='none'?'block':'none'" style="background:var(--gold);color:var(--ocean);border:none;border-radius:8px;padding:8px 16px;font-size:13px;font-weight:500;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">+ Add Table</button>
      </div>

      <!-- Stats row -->
      <div style="display:flex;gap:10px;margin-bottom:1rem;flex-wrap:wrap" id="tm-stats"></div>

      <!-- Add table form (hidden by default) -->
      <div id="tm-add-form" style="display:none;background:var(--card);border:.5px solid var(--border);border-radius:12px;padding:1.2rem;margin-bottom:1rem">
        <div style="font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--muted);margin-bottom:12px">New Table Details</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:10px">
          <div>
            <div style="font-size:10px;color:var(--muted);margin-bottom:4px;letter-spacing:1px;text-transform:uppercase">Table Name</div>
            <input id="tm-name" placeholder="e.g. Table 13 or VIP A" style="width:100%;background:var(--surface);border:.5px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;padding:9px 11px;font-family:system-ui,-apple-system,sans-serif">
          </div>
          <div>
            <div style="font-size:10px;color:var(--muted);margin-bottom:4px;letter-spacing:1px;text-transform:uppercase">Seats</div>
            <select id="tm-seats" style="width:100%;background:var(--surface);border:.5px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;padding:9px 11px;font-family:system-ui,-apple-system,sans-serif">
              <option>2</option><option>4</option><option selected>6</option><option>8</option><option>10</option><option>12</option>
            </select>
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:12px">
          <div>
            <div style="font-size:10px;color:var(--muted);margin-bottom:4px;letter-spacing:1px;text-transform:uppercase">Assigned Waiter</div>
            <input id="tm-waiter" placeholder="e.g. Amina" style="width:100%;background:var(--surface);border:.5px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;padding:9px 11px;font-family:system-ui,-apple-system,sans-serif">
          </div>
          <div>
            <div style="font-size:10px;color:var(--muted);margin-bottom:4px;letter-spacing:1px;text-transform:uppercase">Section</div>
            <select id="tm-section" style="width:100%;background:var(--surface);border:.5px solid var(--border);border-radius:8px;color:var(--text);font-size:13px;padding:9px 11px;font-family:system-ui,-apple-system,sans-serif">
              <option>Main Hall</option><option>Terrace</option><option>VIP Room</option><option>Bar Area</option><option>Garden</option>
            </select>
          </div>
        </div>
        <button onclick="tmAddTable()" style="width:100%;background:var(--gold);color:var(--ocean);border:none;border-radius:10px;padding:12px;font-size:14px;font-weight:500;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">+ Add Table</button>
      </div>

      <!-- Filter bar -->
      <div style="display:flex;gap:8px;margin-bottom:1rem;flex-wrap:wrap" id="tm-filter-row">
        <button class="filter-tab active" onclick="tmSetFilter('all',this)">All</button>
        <button class="filter-tab" onclick="tmSetFilter('Main Hall',this)">Main Hall</button>
        <button class="filter-tab" onclick="tmSetFilter('Terrace',this)">Terrace</button>
        <button class="filter-tab" onclick="tmSetFilter('VIP Room',this)">VIP Room</button>
        <button class="filter-tab" onclick="tmSetFilter('Garden',this)">Garden</button>
        <button class="filter-tab" onclick="tmSetFilter('Bar Area',this)">Bar Area</button>
      </div>

      <!-- Table grid -->
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px" id="tm-grid"></div>
    </div>
  </div>

  <!-- DAILY SALES REPORT -->
  <div id="report-panel" class="staff-panel">
    <div style="max-width:720px;margin:0 auto">

      <!-- Header row -->
      <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:1.2rem">
        <div>
          <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.6rem;color:var(--gold)">Daily Sales Report</div>
          <div style="font-size:11px;color:var(--muted);letter-spacing:.5px;margin-top:2px" id="rpt-date-label">Loading…</div>
        </div>
        <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
          <input type="date" id="rpt-date" style="background:var(--card);border:.5px solid var(--border);border-radius:8px;color:var(--text);font-size:12px;padding:7px 10px;font-family:system-ui,-apple-system,sans-serif" onchange="renderReport()">
          <button onclick="exportReportCSV()" style="padding:7px 14px;border-radius:8px;border:.5px solid var(--border);background:var(--card);color:var(--muted);font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">⬇ Export CSV</button>
          <button onclick="renderReport()" style="padding:7px 14px;border-radius:8px;border:.5px solid var(--border);background:var(--ocean-mid);color:var(--muted);font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">⟳ Refresh</button>
        </div>
      </div>

      <!-- KPI cards -->
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;margin-bottom:1.4rem" id="rpt-kpis"></div>

      <!-- Top Items -->
      <div style="background:var(--card);border:.5px solid var(--border);border-radius:14px;padding:1rem;margin-bottom:1rem">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;color:var(--gold);margin-bottom:.8rem">🏆 Top Selling Items</div>
        <div id="rpt-top-items"><div style="color:var(--muted);font-size:12px;text-align:center;padding:1rem">No orders yet today.</div></div>
      </div>

      <!-- Hourly breakdown -->
      <div style="background:var(--card);border:.5px solid var(--border);border-radius:14px;padding:1rem;margin-bottom:1rem">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;color:var(--gold);margin-bottom:.8rem">⏰ Orders by Hour</div>
        <div id="rpt-hourly"></div>
      </div>

      <!-- Order list -->
      <div style="background:var(--card);border:.5px solid var(--border);border-radius:14px;padding:1rem">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.1rem;color:var(--gold);margin-bottom:.8rem">📋 All Orders</div>
        <div id="rpt-orders-list"></div>
      </div>

    </div>
  </div>

<!-- ══ MANAGER: PIN ══ -->
<div id="manager-login-screen" class="screen-flex" style="display:none">
  <div class="login-card">
    <div class="login-icon">👔</div>
    <div class="login-title">Manager Access</div>
    <div class="login-sub">Enter your Manager PIN to access<br>the full monitoring dashboard</div>
    <div class="pin-error" id="mgr-pin-error">&nbsp;</div>
    <div class="pin-display">
      <div class="pin-dot" id="mpd0"></div><div class="pin-dot" id="mpd1"></div>
      <div class="pin-dot" id="mpd2"></div><div class="pin-dot" id="mpd3"></div>
      <div class="pin-dot" id="mpd4"></div><div class="pin-dot" id="mpd5"></div>
    </div>
    <div class="pin-pad">
      <button class="pin-key" onclick="mgrPinPress('1')">1</button>
      <button class="pin-key" onclick="mgrPinPress('2')">2</button>
      <button class="pin-key" onclick="mgrPinPress('3')">3</button>
      <button class="pin-key" onclick="mgrPinPress('4')">4</button>
      <button class="pin-key" onclick="mgrPinPress('5')">5</button>
      <button class="pin-key" onclick="mgrPinPress('6')">6</button>
      <button class="pin-key" onclick="mgrPinPress('7')">7</button>
      <button class="pin-key" onclick="mgrPinPress('8')">8</button>
      <button class="pin-key" onclick="mgrPinPress('9')">9</button>
      <button class="pin-key" onclick="mgrPinBack()">⌫</button>
      <button class="pin-key" onclick="mgrPinPress('0')">0</button>
      <button class="pin-key" style="font-size:12px;color:var(--muted)" onclick="cancelManagerLogin()">Cancel</button>
    </div>
  </div>
</div>

<!-- ══ MANAGER: SHELL ══ -->
<div id="manager-shell" style="display:none;flex-direction:column;min-height:100vh">
  <div class="staff-header" style="background:linear-gradient(135deg,#0d1f10,#0b2f1a);border-bottom:1px solid #1e4030">
    <div style="display:flex;align-items:center;gap:10px">
      <div style="font-size:20px">👔</div>
      <div>
        <div class="staff-brand" style="color:#6dd98a">Manager Dashboard</div>
        <div style="font-size:10px;color:#3a7a50;letter-spacing:1px;text-transform:uppercase" id="mgr-panel-brand">Dar Fish Market</div>
      </div>
    </div>
    <div style="display:flex;align-items:center;gap:8px">
      <div style="font-size:11px;color:#3a7a50;display:flex;align-items:center;gap:5px"><span class="live-dot" style="background:#3d9a5c"></span>Live Monitoring</div>
      <button class="logout-btn" onclick="managerLogout()" style="border-color:#1e4030;color:#3a7a50">🔒 Lock</button>
    </div>
  </div>
  <div class="staff-tabs" style="background:#0a1a10;border-bottom:1px solid #1e4030">
    <button class="staff-tab mgr-tab active" onclick="showMgrPanel('mgr-overview',this)">📊 Overview</button>
    <button class="staff-tab mgr-tab" onclick="showMgrPanel('mgr-sales',this);renderMgrSales()">💰 Sales Report</button>
    <button class="staff-tab mgr-tab" onclick="showMgrPanel('mgr-items',this);renderMgrItems()">🏆 Top Items</button>
    <button class="staff-tab mgr-tab" onclick="showMgrPanel('mgr-staff',this);renderMgrStaff()">🙋 Staff Monitor</button>
    <button class="staff-tab mgr-tab" onclick="showMgrPanel('mgr-tables',this);renderMgrTables()">🪑 Tables</button>
    <button class="staff-tab mgr-tab" onclick="showMgrPanel('mgr-orders',this);renderMgrOrders()">📋 All Orders</button>
  </div>

  <!-- OVERVIEW -->
  <div id="mgr-overview" class="staff-panel active" style="max-width:780px;margin:0 auto;width:100%">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:1.2rem">
      <div>
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;color:#6dd98a">Good day, Manager 👔</div>
        <div style="font-size:12px;color:#3a7a50;margin-top:3px" id="mgr-datetime"></div>
      </div>
      <button onclick="renderMgrOverview()" style="padding:8px 16px;border-radius:8px;border:.5px solid #1e4030;background:#0a1a10;color:#3a7a50;font-size:12px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">⟳ Refresh</button>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;margin-bottom:1.4rem" id="mgr-kpis"></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:1.2rem">
      <div style="background:#0a1a10;border:.5px solid #1e4030;border-radius:14px;padding:1rem">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:#6dd98a;margin-bottom:.7rem">🍳 Kitchen Status</div>
        <div id="mgr-kitchen-status"></div>
      </div>
      <div style="background:#0a1a10;border:.5px solid #1e4030;border-radius:14px;padding:1rem">
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:#6dd98a;margin-bottom:.7rem">🪑 Table Status</div>
        <div id="mgr-table-status"></div>
      </div>
    </div>
    <div style="background:#0a1a10;border:.5px solid #1e4030;border-radius:14px;padding:1rem">
      <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:#6dd98a;margin-bottom:.7rem">🕐 Recent Orders</div>
      <div id="mgr-recent-orders"></div>
    </div>
  </div>

  <!-- SALES REPORT -->
  <div id="mgr-sales" class="staff-panel" style="max-width:780px;margin:0 auto;width:100%">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:1.2rem">
      <div>
        <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;color:#6dd98a">Sales Report</div>
        <div style="font-size:11px;color:#3a7a50;margin-top:2px" id="mgr-sales-date-label"></div>
      </div>
      <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center">
        <input type="date" id="mgr-sales-date" style="background:#0a1a10;border:.5px solid #1e4030;border-radius:8px;color:var(--text);font-size:12px;padding:7px 10px;font-family:system-ui,-apple-system,sans-serif" onchange="renderMgrSales()">
        <button onclick="exportMgrCSV()" style="padding:7px 14px;border-radius:8px;border:.5px solid #1e4030;background:#0a1a10;color:#3a7a50;font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">⬇ Export CSV</button>
        <button onclick="renderMgrSales()" style="padding:7px 14px;border-radius:8px;border:.5px solid #1e4030;background:#0a1a10;color:#3a7a50;font-size:11px;cursor:pointer;font-family:system-ui,-apple-system,sans-serif">⟳ Refresh</button>
      </div>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;margin-bottom:1.2rem" id="mgr-sales-kpis"></div>
    <div style="background:#0a1a10;border:.5px solid #1e4030;border-radius:14px;padding:1rem;margin-bottom:1rem">
      <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:#6dd98a;margin-bottom:.7rem">⏰ Revenue by Hour</div>
      <div id="mgr-hourly"></div>
    </div>
    <div style="background:#0a1a10;border:.5px solid #1e4030;border-radius:14px;padding:1rem">
      <div style="font-family:Georgia,'Times New Roman',serif;font-size:1rem;color:#6dd98a;margin-bottom:.7rem">📋 Orders for the Day</div>
      <div id="mgr-day-orders"></div>
    </div>
  </div>

  <!-- TOP ITEMS -->
  <div id="mgr-items" class="staff-panel" style="max-width:780px;margin:0 auto;width:100%">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:1.2rem">
      <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;color:#6dd98a">Top Selling Items</div>
      <select id="mgr-items-range" onchange="renderMgrItems()" style="background:#0a1a10;border:.5px solid #1e4030;border-radius:8px;color:var(--text);font-size:12px;padding:7px 12px;font-family:system-ui,-apple-system,sans-serif">
        <option value="today">Today</option>
        <option value="7">Last 7 Days</option>
        <option value="30">Last 30 Days</option>
        <option value="all">All Time</option>
      </select>
    </div>
    <div id="mgr-items-grid"></div>
  </div>

  <!-- STAFF MONITOR -->
  <div id="mgr-staff" class="staff-panel" style="max-width:780px;margin:0 auto;width:100%">
    <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;color:#6dd98a;margin-bottom:1.2rem">Staff Performance</div>
    <div id="mgr-staff-grid"></div>
  </div>

  <!-- TABLES -->
  <div id="mgr-tables" class="staff-panel" style="max-width:780px;margin:0 auto;width:100%">
    <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;color:#6dd98a;margin-bottom:1.2rem">Table Overview</div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:10px;margin-bottom:1rem" id="mgr-tables-stats"></div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:10px" id="mgr-tables-grid"></div>
  </div>

  <!-- ALL ORDERS -->
  <div id="mgr-orders" class="staff-panel" style="max-width:780px;margin:0 auto;width:100%">
    <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px;margin-bottom:1.2rem">
      <div style="font-family:Georgia,'Times New Roman',serif;font-size:1.7rem;color:#6dd98a">All Orders</div>
      <div style="display:flex;gap:8px;flex-wrap:wrap">
        <select id="mgr-orders-filter" onchange="renderMgrOrders()" style="background:#0a1a10;border:.5px solid #1e4030;border-radius:8px;color:var(--text);font-size:12px;padding:7px 12px;font-family:system-ui,-apple-system,sans-serif">
          <option value="all">All Statuses</option>
          <option value="new">New</option>
          <option value="cooking">Cooking</option>
          <option value="ready">Ready</option>
          <option value="done">Done</option>
        </select>
        <select id="mgr-orders-range" onchange="renderMgrOrders()" style="background:#0a1a10;border:.5px solid #1e4030;border-radius:8px;color:var(--text);font-size:12px;padding:7px 12px;font-family:system-ui,-apple-system,sans-serif">
          <option value="today">Today</option>
          <option value="7">Last 7 Days</option>
          <option value="all">All Time</option>
        </select>
      </div>
    </div>
    <div id="mgr-orders-list"></div>
  </div>
</div>

<!-- Hidden staff trigger bottom-right corner — tap 5 times -->
<div onclick="staffTriggerTap()" style="position:fixed;bottom:0;right:0;width:50px;height:50px;z-index:9999;opacity:0;cursor:default"></div>

<script>
// ════════════════════════════════════════
// ⚙️ CONFIG — change these
// ════════════════════════════════════════
// PINs are stored as SHA-256 hashes, not plain text — can't be read from page source.
// To set a new PIN: open this page, open browser console, run:
//   await sha256('your-new-pin')
// then paste the printed hash below.
// Staff PIN: 482917  |  Manager PIN: 736205  — CHANGE THESE TOO if you want, just re-hash with sha256().
const STAFF_PIN_HASH   = '6dcd932e017833c58b1340b6d8a8f40294430c122cb84544a48ffeea7d275927'; // hash of 482917
const MANAGER_PIN_HASH = 'a8289ef676c0b102512ef6affdddc60f1659e1fe672ccecc0b2edd36e051c78f'; // hash of 736205
const NUM_TABLES  = 200;      // ← number of tables

async function sha256(msg){
  const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(msg));
  return Array.from(new Uint8Array(buf)).map(b=>b.toString(16).padStart(2,'0')).join('');
}
// Escapes text before it's inserted via innerHTML, to prevent stored XSS
// (e.g. from the special-requests box or URL params being rendered on staff/manager screens).
function escapeHtml(str){
  return String(str ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
// Calls a backend Cloud Function (verifyPin / placeOrderSecure / updateMenu).
// Only ever called when backendAuthReady is true — every caller falls back
// to the old local-only behavior otherwise, so the app works with or without
// the backend deployed.
function callFn(name, payload){
  return firebase.functions().httpsCallable(name)(payload);
}
function friendlyFnError(e){
  if(e && e.message) return (e.code==='resource-exhausted' ? '🔒 ' : '❌ ') + e.message;
  return '❌ Something went wrong — please try again.';
}

// ════════════════════════════════════════════════════════════════════
// 🏷️ BRAND_CONFIG — everything that changes when you reuse this file
// for a different restaurant. Edit this one block; applyBranding()
// pushes it into the page automatically on load. Menu items, colors,
// and PINs still need their own edits (see NEW_RESTAURANT_CHECKLIST.md).
// ════════════════════════════════════════════════════════════════════
const BRAND_CONFIG = {
  name:       "Dar Fish Market",                              // full name (header, page title)
  shortCode:  "DFM",                                           // used in order IDs & filenames, e.g. #DFM-...
  tagline:    "msasan · Dar es Salaam · New wave", // under the header on the menu screen
  coverWord1: "DAR",                                           // cover screen, top word
  coverWord2: "Fish Market",                                   // cover screen, second line
  coverLine1: "Same Ocean",                                    // cover screen headline, line 1
  coverLine2: "New Wave",                                      // cover screen headline, line 2
  coverTagline: "…Food Menu…",                                 // cover screen, script tagline
};
function applyBranding(){
  document.title = BRAND_CONFIG.name + " Restaurant";
  const set = (id, text) => { const el = document.getElementById(id); if(el) el.textContent = text; };
  set('cv-brand', BRAND_CONFIG.coverWord1);
  set('cv-brand-sub', BRAND_CONFIG.coverWord2);
  set('cv-h1', BRAND_CONFIG.coverLine1);
  set('cv-h2', BRAND_CONFIG.coverLine2);
  set('cv-tagline', BRAND_CONFIG.coverTagline);
  set('hdr-brand', BRAND_CONFIG.name);
  set('hdr-brand-sub', BRAND_CONFIG.tagline);
  set('staff-panel-title', BRAND_CONFIG.shortCode + ' Staff Panel');
  set('mgr-panel-brand', BRAND_CONFIG.name);
}

const FIREBASE_CONFIG = {
  apiKey: "AIza...",
authDomain: "dfm-restaurant.firebaseapp.com",
databaseURL: "https://dfm-restaurant-default-rtdb...",
projectId: "dfm-restaurant",
};

// ════════════════════════════════════════
// URL params — set by QR code link
// Anyone can edit a URL, so these are validated/whitelisted before use —
// otherwise a crafted link could inject script into staff/manager screens
// or let a customer order under a fake waiter's name.
// ════════════════════════════════════════
const params = new URLSearchParams(location.search);

// 🔧 Add your real staff names here. Anything not in this list falls back to the first name.
const VALID_WAITERS = ['Amina','Juma','Fatuma'];

const rawTable  = params.get('table')  || '1';
const TABLE     = rawTable.replace(/[^a-zA-Z0-9 \-]/g,'').slice(0,12) || '1';
const rawWaiter = params.get('waiter') || VALID_WAITERS[0];
const WAITER    = VALID_WAITERS.includes(rawWaiter) ? rawWaiter : VALID_WAITERS[0];

document.getElementById('table-display').textContent  = TABLE;
document.getElementById('waiter-display').textContent = WAITER;

// ════════════════════════════════════════
// FIREBASE
// ════════════════════════════════════════
let db = null, firebaseReady = false, staffLoggedIn = false, mgrLoggedIn = false;
let backendAuthReady = false; // true once signed in (anon or staff/manager) — gates calls to Cloud Functions
window._liveOrders = [];

function initFirebase(){
  if(FIREBASE_CONFIG.apiKey==='PASTE_YOUR_API_KEY_HERE'){
    setConn(false,'Local mode'); return;
  }
  try{
    if(!firebase.apps.length) firebase.initializeApp(FIREBASE_CONFIG);
    db = firebase.database();
    firebaseReady = true;
    setConn(true,'Connected');

    // ── Backend auth: every device (customer or staff) signs in so Cloud Functions
    // can identify it for rate limiting / PIN lockout / role checks. ──
    firebase.auth().onAuthStateChanged(user=>{ backendAuthReady = !!user; });
    firebase.auth().signInAnonymously().catch(()=>{ backendAuthReady = false; });

    db.ref('orders').orderByChild('ts').on('value', snap=>{
      const data = snap.val()||{};
      const newOrders = Object.values(data).sort((a,b)=>b.ts-a.ts);
      if(staffLoggedIn && window._liveOrders.length>0){
        const prevIds=window._liveOrders.map(o=>o.id);
        const hasNew=newOrders.some(o=>!prevIds.includes(o.id)&&o.status==='new');
        if(hasNew) playNotification();
      }
      window._liveOrders = newOrders;
      if(staffLoggedIn){
        if(document.getElementById('kitchen-panel').classList.contains('active')) renderKitchen();
        if(document.getElementById('waiter-panel').classList.contains('active'))  renderWaiter();
      }
      if(mgrLoggedIn){
        if(document.getElementById('mgr-overview').classList.contains('active')) renderMgrOverview();
        if(document.getElementById('mgr-orders').classList.contains('active'))   renderMgrOrders();
      }
    });

    // ── MENU SYNC — keeps every device (customer phones, staff, manager) showing
    // the same live menu instead of each device's own local copy ──
    db.ref('menu').on('value', snap=>{
      const cloudMenu = snap.val();
      if(cloudMenu){
        menuData = cloudMenu;
        localStorage.setItem('dfm_menu', JSON.stringify(menuData)); // offline cache only
        renderMenu();
        if(staffLoggedIn) renderAdminList();
      } else {
        // Nothing in the cloud yet (first-ever launch) — seed it from this device's menu.
        db.ref('menu').set(menuData);
      }
    });
  } catch(e){ setConn(false,'Offline'); }
}
function setConn(on,label){
  document.getElementById('conn-dot').className='conn-dot '+(on?'online':'offline');
  document.getElementById('conn-label').textContent=label;
}
async function saveOrderToCloud(o){
  if(!firebaseReady||!db){ localSave(o); queuePendingOrder({mode:'local',payload:o,queuedAt:Date.now()}); return false; }
  try{ await db.ref('orders/'+o.id.replace(/[#.]/g,'-')).set(o); return true; }
  catch(e){ localSave(o); queuePendingOrder({mode:'local',payload:o,queuedAt:Date.now()}); return false; }
}
async function cloudStatus(id,status){
  if(!firebaseReady||!db) return;
  try{ await db.ref('orders/'+id.replace(/[#.]/g,'-')+'/status').set(status); }
  catch(e){}
}
const localSave  = o=>{ const a=lGet(); a.unshift(o); localStorage.setItem('dfm_orders',JSON.stringify(a)); };
const lGet       = ()=>JSON.parse(localStorage.getItem('dfm_orders')||'[]');
const lSaveAll   = a=>localStorage.setItem('dfm_orders',JSON.stringify(a));
const getOrders  = ()=>firebaseReady?window._liveOrders:lGet();
const saveOrders = a=>{ if(!firebaseReady) lSaveAll(a); };

// ════════════════════════════════════════════════════════════════════
// OFFLINE ORDER QUEUE — if an order can't reach Firebase/the backend
// (restaurant WiFi drop, customer's signal, etc.) it's saved here and
// retried automatically once the connection comes back. This is what
// actually answers "does it remember orders if the internet drops" —
// the old localSave() above only ever wrote to one device with no way
// back; this queue is what closes that gap.
// ════════════════════════════════════════════════════════════════════
function getPendingQueue(){ try{ return JSON.parse(localStorage.getItem('dfm_pending_orders')||'[]'); }catch(e){ return []; } }
function savePendingQueue(q){ localStorage.setItem('dfm_pending_orders',JSON.stringify(q)); updatePendingBadge(); }
function queuePendingOrder(entry){ const q=getPendingQueue(); q.push(entry); savePendingQueue(q); }
function updatePendingBadge(){
  const q=getPendingQueue();
  const el=document.getElementById('pending-badge');
  if(!el) return;
  if(q.length>0){ el.style.display='inline-flex'; el.textContent=`📦 ${q.length} order${q.length>1?'s':''} waiting to sync`; }
  else { el.style.display='none'; }
}
let flushInFlight=false;
async function flushPendingOrders(){
  if(flushInFlight) return;
  const q=getPendingQueue();
  if(q.length===0) return;
  flushInFlight=true;
  const remaining=[];
  for(const entry of q){
    try{
      if(entry.mode==='backend'){
        if(!backendAuthReady) throw new Error('not ready');
        await callFn('placeOrderSecure', entry.payload);
      } else {
        if(!firebaseReady||!db) throw new Error('not ready');
        await db.ref('orders/'+entry.payload.id.replace(/[#.]/g,'-')).set(entry.payload);
      }
      // success — dropped, not added to `remaining`
    } catch(e){
      remaining.push(entry); // still can't send — keep it queued for next try
    }
  }
  savePendingQueue(remaining);
  flushInFlight=false;
}
window.addEventListener('online', flushPendingOrders);
setInterval(flushPendingOrders, 20000);

// ════════════════════════════════════════
// MENU DATA
// ════════════════════════════════════════
const defaultMenu={
  starters:[
    {id:'s1',name:'Calamari Fritti',desc:'Crispy fried calamari rings, tamarind & sriracha dipping sauce',price:18000,emoji:'🦑',tags:['fresh'],img:'https://images.unsplash.com/photo-1599487488170-d11ec9c172f0?w=600&q=80'},
    {id:'s2',name:'Chaza za Bahari',desc:'Fresh Zanzibar oysters, half dozen, lemon, tabasco & mignonette',price:22000,emoji:'🦪',tags:['fresh'],img:'https://images.unsplash.com/photo-1606731219412-3b1b33e07e2e?w=600&q=80'},
    {id:'s3',name:'Prawn Skewers',desc:'Grilled tiger prawns, garlic butter, coastal herb sauce',price:20000,emoji:'🍢',tags:['fresh','grill'],img:'https://images.unsplash.com/photo-1565557623262-b51c2513a641?w=600&q=80'},
    {id:'s4',name:'Fish Soup',desc:'Spiced Indian Ocean fish broth, lemongrass, coconut, lime',price:12000,emoji:'🍲',tags:['fresh'],img:'https://images.unsplash.com/photo-1547592166-23ac45744acd?w=600&q=80'},
    {id:'s5',name:'Kachumbari Salad',desc:'Fresh coastal tomato & onion, lime, coriander, chilli',price:8000,emoji:'🥗',tags:['spicy'],img:'https://images.unsplash.com/photo-1512621776951-a57141f2eefd?w=600&q=80'},
  ],
  mains:[
    {id:'m1',name:'Lobster Thermidor',desc:'DFM signature — whole lobster, creamy mustard sauce, gratin finish',price:95000,emoji:'🦞',tags:['fresh','grill'],img:'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=600&q=80'},
    {id:'m2',name:'Grilled Whole Snapper',desc:'Whole red snapper, coconut & tomato sauce, wali wa nazi, kachumbari',price:42000,emoji:'🐟',tags:['fresh','grill'],img:'https://images.unsplash.com/photo-1467003909585-2f8a72700288?w=600&q=80'},
    {id:'m3',name:'Kamba Zanzibar',desc:'Tiger prawns, pilipili sauce, steamed jasmine rice & side salad',price:52000,emoji:'🦐',tags:['fresh','spicy'],img:'https://images.unsplash.com/photo-1565557623262-b51c2513a641?w=600&q=80'},
    {id:'m4',name:'Pweza wa Kupika',desc:'Slow-cooked octopus, Swahili spices, cassava chips, coconut sauce',price:38000,emoji:'🐙',tags:['fresh'],img:'https://images.unsplash.com/photo-1625944230945-1b7dd3b949ab?w=600&q=80'},
    {id:'m5',name:'Mixed Seafood Grill',desc:'Platter of lobster tail, crab, prawns & fish — chargrilled, lemon butter',price:75000,emoji:'🍽️',tags:['fresh','grill'],img:'https://images.unsplash.com/photo-1559847844-5315695dadae?w=600&q=80'},
    {id:'m6',name:'Samaki wa Kupaka',desc:'Traditional fish in rich coconut milk & turmeric sauce, ugali',price:32000,emoji:'🍛',tags:['fresh'],img:'https://images.unsplash.com/photo-1455619452474-d2be8b1e70cd?w=600&q=80'},
    {id:'m7',name:'Fish & Chips',desc:'Beer-battered local fish, hand-cut chips, tartare sauce, lemon',price:28000,emoji:'🐠',tags:['fresh'],img:'https://images.unsplash.com/photo-1544025162-d76538b2a681?w=600&q=80'},
  ],
  sushi:[
    {id:'su1',name:'Classic Sashimi',desc:'Chef selection 12 pieces — tuna, salmon, yellowfin, wasabi & soy',price:45000,emoji:'🍣',tags:['sushi','fresh'],img:'https://images.unsplash.com/photo-1617196034183-421b4040ed20?w=600&q=80'},
    {id:'su2',name:'DFM Signature Roll',desc:'Prawn tempura, avocado, cucumber, topped with torched salmon & sriracha',price:38000,emoji:'🍱',tags:['sushi','spicy'],img:'https://images.unsplash.com/photo-1562802378-063ec186a863?w=600&q=80'},
    {id:'su3',name:'Tuna Tataki',desc:'Seared yellowfin tuna, ponzu, sesame, micro herbs, radish',price:42000,emoji:'🐟',tags:['sushi','fresh'],img:'https://images.unsplash.com/photo-1617196034099-5bb4b84c7b4f?w=600&q=80'},
    {id:'su4',name:'Salmon Nigiri (6 pcs)',desc:'Hand-pressed rice, Atlantic salmon, pickled ginger, wasabi',price:32000,emoji:'🍣',tags:['sushi','fresh'],img:'https://images.unsplash.com/photo-1617196034183-421b4040ed20?w=600&q=80'},
    {id:'su5',name:'Veg Maki (8 pcs)',desc:'Avocado, cucumber, mango roll, sesame seeds, soy dip',price:22000,emoji:'🥑',tags:['sushi'],img:'https://images.unsplash.com/photo-1562802378-063ec186a863?w=600&q=80'},
  ],
  desserts:[
    {id:'d1',name:'Coconut Panna Cotta',desc:'Silky coconut panna cotta, passion fruit coulis, toasted coconut',price:14000,emoji:'🍮',tags:[],img:'https://images.unsplash.com/photo-1488477181946-6428a0291777?w=600&q=80'},
    {id:'d2',name:'Halwa ya Zanzibar',desc:'Traditional Zanzibari halwa, rosewater, cardamom, pistachios',price:10000,emoji:'🍬',tags:[],img:'https://images.unsplash.com/photo-1582716401301-b2407dc7563d?w=600&q=80'},
    {id:'d3',name:'Tropical Fruit Platter',desc:'Fresh mango, pineapple, papaya, lime sorbet, mint',price:12000,emoji:'🍍',tags:['fresh'],img:'https://images.unsplash.com/photo-1490474418585-ba9bad8fd0ea?w=600&q=80'},
    {id:'d4',name:'Chocolate Lava Cake',desc:'Warm dark chocolate fondant, vanilla ice cream, caramel drizzle',price:16000,emoji:'🍫',tags:[],img:'https://images.unsplash.com/photo-1624353365286-3f8d62daad51?w=600&q=80'},
  ],
  drinks:[
    {id:'dr1',name:'Fresh Mango Juice',desc:'Cold-pressed Tanzanian mangoes, no sugar added',price:5000,emoji:'🥭',tags:['fresh'],img:'https://images.unsplash.com/photo-1534353436294-0dbd4bdac845?w=600&q=80'},
    {id:'dr2',name:'Madafu',desc:'Young coconut water, served fresh in the shell',price:4000,emoji:'🥥',tags:['fresh'],img:'https://images.unsplash.com/photo-1560023907-5f339617ea30?w=600&q=80'},
    {id:'dr3',name:'Tangawizi Lemonade',desc:'House ginger lemonade, honey, lime, soda water',price:6000,emoji:'🍋',tags:['spicy'],img:'https://images.unsplash.com/photo-1621263764928-df1444c5e859?w=600&q=80'},
    {id:'dr4',name:'DFM Cocktail',desc:'Signature coastal cocktail — rum, coconut, passion fruit, lime',price:15000,emoji:'🍹',tags:[],img:'https://images.unsplash.com/photo-1513558161293-cdaf765ed2fd?w=600&q=80'},
    {id:'dr5',name:'Kilimanjaro Lager',desc:"Tanzania's finest cold lager, 500ml",price:5500,emoji:'🍺',tags:[],img:'https://images.unsplash.com/photo-1608270586620-248524c67de9?w=600&q=80'},
    {id:'dr6',name:'Konyagi & Lime',desc:'Tanzanian spirit, over ice with fresh lime & tonic',price:8000,emoji:'🥃',tags:[],img:'https://images.unsplash.com/photo-1569529465841-dfecdab7503b?w=600&q=80'},
    {id:'dr7',name:'Chai ya Tangawizi',desc:'Spiced ginger tea, cardamom, cinnamon, honey',price:4000,emoji:'☕',tags:['spicy'],img:'https://images.unsplash.com/photo-1556679343-c7306c1976bc?w=600&q=80'},
    {id:'dr8',name:'Still / Sparkling Water',desc:'Evian or Perrier, 750ml',price:3000,emoji:'💧',tags:[],img:''},
